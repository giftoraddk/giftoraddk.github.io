---
import "../styles/themes/default.css";
import { ClientRouter, fade } from "astro:transitions";
import Head from "@/components/Head/Base.astro";
import NavBase from "@/components/Nav/Base.astro";
import UtilityBar from "@/components/Nav/Action/UtilityBar.astro";
import FooterOptimal from "@/components/Footer/Optimal.astro";
import { COOKIE_CONFIG } from "@/services/core/cookier.js";
import { site } from "@/services/tools/site";
import { layoutTints, layoutClasses, themeCSS } from "@/services/tools/page.js";
// Props astro
const {
	title,
	description,
	image,
	articleDate,
	noindex = false, // forward tới <Head> — xem Head/Base.astro
	jsonLd = [], // object[] JSON-LD riêng của trang — forward tới <Head> (cùng prop của Core.astro)
	lang = site.defaultLang, // <html lang> lúc SSR — trang nội dung tiếng Việt (vd /gift/*) truyền 'vi'
	menu = {
    type: "top",
    position: "default", // default, prefix, suffix
    // variant: 'float' (thanh nổi bo tròn) | 'minimal' (tràn ngang, không viền) — cả hai link chữ + chấm
    // (Nav/Top.astro .nav-float/.nav-minimal, menu.css .menu-float/.menu-minimal); bỏ trống = kiểu cũ
  },
	footer = {},
	bg = {}, // props <svc-underlay>; null = tắt underlay
	tints = null, // [a, b] tên màu theme — xem tintPair bên dưới; có tints thì underlay tắt
  theme = "light", // data-theme value, cũng là key chọn variant[theme]
	variant = {}, // { [theme]: { ui, mainColors, bgColors, textColor, bgImage } }
  shop = {
    sellerId: '', // user id người bán — modules/gift/shop.js (khớp SELLER_IDS của Worker auth)
    seller: '', // name~phone~address~email~taxCode
    wallet: {},
    vietqr: {},
    cashDisabled: false,
  },
  bar = null, // { hotlineLabel, socialsLabel, socials: [{ icon, href, text }] } — không truyền thì ẩn UtilityBar
} = Astro.props;

// tints / class bố cục / CSS màu theo theme — logic dùng chung với Core.astro, xem services/tools/page.js
const { tintPair, tintStyle, showUnderlay } = layoutTints(tints, bg);
const { isHorizontal, wrapClass, screenClass } = layoutClasses(menu);
const themeStyles = themeCSS(variant);

const { ui, mainColors } = variant[theme] ?? {}; // forwarded as data-ui on <html> (pastel UI variant hook) + passed to the new fixed warden/stats fabs below for visual consistency with the page's configured theme
---

<html lang={lang} class="scroll-smooth overflow-hidden" data-theme={theme} data-ui={ui}>
	<head>
		<ClientRouter />
		<Head
			title={title}
			description={description}
			ogImage={image}
			articleDate={articleDate}
			noindex={noindex}
			jsonLd={jsonLd}
		/>
		<style set:html={themeStyles}></style>
		<!-- Apply saved theme before first paint to prevent flash -->
		<script define:vars={{ themeCookie: COOKIE_CONFIG.THEME, langCookie: COOKIE_CONFIG.LANGUAGE }} is:inline>
			(function() {
				const m = document.cookie.match(new RegExp('(?:^|; )' + themeCookie + '=([^;]*)'));
				const t = m ? decodeURIComponent(m[1]) : null;
				if (t) document.documentElement.setAttribute('data-theme', t);
				const lm = document.cookie.match(new RegExp('(?:^|; )' + langCookie + '=([^;]*)'));
				const l = lm ? decodeURIComponent(lm[1]) : null;
				if (l) document.documentElement.setAttribute('lang', l);
			})();
			// Carry theme/lang across SPA transitions before Astro swaps the new document in
			document.addEventListener('astro:before-swap', function(e) {
				const theme = document.documentElement.getAttribute('data-theme');
				if (theme) e.newDocument.documentElement.setAttribute('data-theme', theme);
				const lang = document.documentElement.getAttribute('lang');
				if (lang) e.newDocument.documentElement.setAttribute('lang', lang);
			});
		</script>
    
    <script is:inline>
      document.addEventListener('click', (e) => {
        const a = e.target.closest('a[href^="#"]')
        if (!a) return
        const id = decodeURIComponent(a.getAttribute('href').slice(1))
        const el = document.getElementById(id)
        if (!el) return
        e.preventDefault()
        const container = document.getElementById('main-wrap') ?? document.documentElement
        const top = el.getBoundingClientRect().top - container.getBoundingClientRect().top + container.scrollTop
        container.scrollTo({ top, behavior: 'smooth' })
      })
    </script>
    
    <script is:inline>
      document.addEventListener('click', (e) => {
        const a = e.target.closest('a[href^="#"]')
        if (!a) return
        const id = decodeURIComponent(a.getAttribute('href').slice(1))
        const el = document.getElementById(id)
        if (!el) return
        e.preventDefault()
        el.scrollIntoView({ behavior: 'smooth', block: 'start' })
      })
    </script>
	</head>

	<body transition:animate={fade({ duration: "0.5s" })}>
		<div
			id="main-wrap"
			class={wrapClass + (isHorizontal ? screenClass : "") + (tintPair ? " has-tints" : "")}
			style={tintStyle}
		>
			<!-- Utility bar: chỉ render khi có prop bar -->
			{bar && (
				<UtilityBar
					hotlineLabel={bar.hotlineLabel}
					hotline={bar.hotline}
					address={bar.address}
					socialsLabel={bar.socialsLabel}
					socials={bar.socials ?? []}
				/>
			)}
			<!-- Nav -->
			<NavBase
				logoText=""
				type={menu.type}
        position={menu.position}
				class={`${menu.order || ""} ${menu.type === "mobile" ? "order-last" : ""}`}
				items={menu.menuItems}
				open={true}
				isMenu={true}
				{...(['float', 'minimal'].includes(menu.variant) && { menuClass: `menu-${menu.variant}`, variant: menu.variant })}
			/>
			<!-- Main -->
			<main
				id="main"
				class={`text-base-content ${menu.type === "side" ? "flex-1" + screenClass : "flex-1"}`}
			>
        <!-- Script để ngoài biểu thức: <script> trong {...} Astro không bundle (in thô, alias @/ hỏng). Chỉ định
             nghĩa custom element — không có thẻ <svc-underlay> thì không chạy gì. -->
        <script src="@/packages/adopted/svc-underlay.js"></script>
        {showUnderlay && <svc-underlay id="main-bg" class="-mt-1" transition:persist="main-bg" {...bg}></svc-underlay>}
				<div class="min-h-dvh relative">
          <slot />
        </div>
        
			  <!-- Footer -->
        {(footer.columns || footer.policies || footer.socials) && (
          <FooterOptimal
            columns={footer.columns ?? []}
            policies={footer.policies ?? []}
            socials={footer.socials ?? []}
            contact={footer.contact}
            bg={footer.bg}
            grid={footer.grid ?? 'grid-cols-2 sm:grid-cols-4'}
          />
        )}
			</main>
      	<script src="@/packages/pay/svc-pay.js"></script>
        <svc-pay id="pay-factor" transition:persist="pay-factor" role="buyer" isCart position="fixed"
          onlyDelivery loginRequired
          sellerId={shop?.sellerId}
          seller={shop?.seller}
          wallet={JSON.stringify(shop.wallet)}
          vietqr={JSON.stringify(shop.vietqr)}
          cashDisabled={shop?.cashDisabled}
        ></svc-pay>

        <script src="@/packages/pay/svc-pay-warden.js"></script>
        <svc-pay-warden id="shop-orders-warden" transition:persist="shop-orders-warden"
          position="fixed" x="99%" y="calc(100% - 11rem)"
          ui={ui} theme={theme} mainColors={mainColors} lang="vi">
        </svc-pay-warden>

        <!-- Trợ lý (svc-aide) do trang tự gắn — giftoraddk.com: components/Gift/Aide.astro, tự xếp lên trên cụm nút này
             (y = calc(100% - 14.5rem)) khi có #pay-factor. Không gắn ở đây để mỗi trang chỉ có đúng 1 trợ lý. -->
		</div>

    <script>
      import { auth } from '@/packages/auth/service/service.js';

      // Flow gán role cho <svc-pay-warden> (nút fixed, xem CoreShop.astro's mount ngay phía trên) — isSeller (auth.isAdmin() HOẶC user.id === sellerId, xem dưới — seller
      // của shop này chưa chắc mang cờ admin hệ thống) -> role="seller" (sellerId/wallet đọc thẳng
      // từ #pay-factor, đã đúng props qua prop `shop` của layout, tránh lặp lại 1 sellerId/wallet
      // hardcode nữa) hoặc buyer (bất kỳ ai khác). Mua hàng bắt buộc đăng nhập: #pay-factor (loginRequired) nhận buyerId
      // = người đang đăng nhập — chưa có thì "Đặt hàng" hiện form đăng nhập trước; Worker cũng từ chối đơn không tài khoản.
      async function applyCoreShopRole() {
        const payEl    = document.getElementById('pay-factor') as any;
        const wardenEl = document.getElementById('shop-orders-warden') as any;
        if (!payEl) return;
        const sellerId = payEl.sellerId;
        const wallet   = payEl.wallet;
        const vietqr   = payEl.vietqr;
        const [user, isAdmin] = await Promise.all([auth.get(), auth.isAdmin()]);
        // Seller cũng có thể là 1 user thường (không mang cờ admin hệ thống) — id CHÍNH LÀ
        // sellerId hardcode của shop này thì vẫn coi như đang xem với vai trò seller, không chỉ
        // riêng auth.isAdmin() (super-admin toàn site).
        const isSeller = isAdmin || (user?.id && user.id === sellerId);
        payEl.buyerId = user?.id ?? '';

        if (wardenEl) {
          wardenEl.wallet = wallet;
          wardenEl.vietqr = vietqr; // buyer mở lại đơn CHƯA thanh toán qua nút fixed này cũng cần thấy QR, không chỉ text tài khoản — xem <svc-pay-order>/<svc-pay-valider>
          if (isSeller) {
            wardenEl.role = 'seller';
            wardenEl.sellerId = sellerId;
          } else {
            wardenEl.role = 'buyer';
            wardenEl.buyerId = user?.id ?? '';
          }
        }
      }
      document.addEventListener('astro:page-load', applyCoreShopRole);
      // Đăng nhập / đăng xuất ngay trên trang (form trong giỏ, svc-account…) → cập nhật lại người mua + vai trò
      window.addEventListener('login-success', applyCoreShopRole);
      window.addEventListener('account-change', applyCoreShopRole);
    </script>
	</body>
	<style>
		.bg-wrap {
			background-image: var(--bg-wrap-image, none);
			background-size: cover;
			background-position: center;
		}
		/* tints — glow 2 góc như panel svc-node / svc-radar. Ellipse kích thước CỐ ĐỊNH (px) + nhạt hơn panel:
		   tính theo % thì trên màn rộng quầng sáng phình ra cả trang, trông đậm.
		   Áp lên phần tử cuộn (.bg-wrap: #main-wrap khi menu ngang, <main> khi menu side); nền màu vẫn là
		   bg-base-100, ảnh --bg-wrap-image (variant) nằm dưới cùng. */
		.bg-wrap.has-tints,
		.has-tints .bg-wrap {
			background-image:
				radial-gradient(1000px 560px at 100% 0%, color-mix(in oklab, var(--layout-tint-a) 18%, transparent), transparent 70%),
				radial-gradient(760px 480px at 0% 0%, color-mix(in oklab, var(--layout-tint-b) 15%, transparent), transparent 70%),
				var(--bg-wrap-image, none);
			background-size: 100% 100%, 100% 100%, cover;
			background-repeat: no-repeat;
		}
	</style>
</html>
