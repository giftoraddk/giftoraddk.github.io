---
import LayoutAdmin from '@/layouts/LayoutAdmin.astro';
const pageTitle = 'Mind Admin';
const pageDescription = 'Sale mind (knowledge base) admin page';

const syncTableOptions = [
	{ value: 'products', label: 'Sản phẩm' },
	{ value: 'posts',    label: 'Bài viết' },
];
const csvCategoryOptions = [
	{ value: 'company', label: 'Công ty' },
	{ value: 'policy',  label: 'Chính sách' },
	{ value: 'other',   label: 'Khác' },
];
---

<LayoutAdmin title={pageTitle} description={pageDescription}>
	<div class='p-4'>
		<h1 class='text-xl font-bold mb-5'>Kiến thức tư vấn bán hàng</h1>
		<!-- server='llm' — `mind` sống trong project Firestore RIÊNG (env PUBLIC_DB_LLM), tách khỏi
		     mọi bảng còn lại (xem hook/CRUD.rst "Nhiều kết nối Firestore", hook/SALE.rst) — cùng cơ
		     chế đã dùng cho dataTable='users' server='auth'. -->
		<svc-admin id='admin-mind' dataTable='mind' server='llm' lang='vi' revalidate>
      <div class="flex flex-wrap gap-2">
        <!-- Case 1: đồng bộ lại TOÀN BỘ 1 bảng có sẵn (products/posts) — xem hook/SALE.rst -->
        <div slot='toolbar-start' style='width:130px'>
          <web-select id='mind-sync-table' options={JSON.stringify(syncTableOptions)}
            height='28px' ui='spatial' theme='dark' lang='vi'></web-select>
        </div>
        <web-button slot='toolbar-start' id='mind-sync-btn' type='soft' height='28px'>Nạp lại</web-button>

        <!-- Case 2: nhập dữ liệu ngoài qua CSV — cột CỐ ĐỊNH thứ tự
            title|description|content|tags|pricing|promo|quantity|effectiveFrom|effectiveTo,
            unitType chọn 1 lần áp cho cả file — 2 cột cuối OPTIONAL (rỗng = luôn có hiệu lực,
            xem hook/firebase-multidomain-ai-rag-spec.md §11 temporal retrieval). -->
        <div slot='toolbar-start' style='width:130px'>
          <web-select id='mind-csv-category' options={JSON.stringify(csvCategoryOptions)}
            height='28px' ui='spatial' theme='dark' lang='vi'></web-select>
        </div>
        <input slot='toolbar-start' id='mind-csv-input' type='file' accept='.csv' hidden />
        <web-button slot='toolbar-start' id='mind-csv-btn' type='soft' height='28px'>Nhập CSV ngoài</web-button>
      </div>
		</svc-admin>
	</div>

	<script>
		import '@/webs/auth/svc-admin.js';
		import '@/webs/apex/web-select.js';
		import schema from '@/services/schemas/admin/mind.js';
		import { createService, invalidate as cacheInvalidate } from '@/services/crud.js';
		import { parseCsvRows, toastEmit } from '@/services/helper.js';
		import { syncMindFromOutputTable, buildExternalSearchText, AUTHORITY_BY_UNIT_TYPE, DOMAIN_SALE, MIND_SERVER } from '@/webs/division/tools/mind-sync.js';

		function reloadMindGrid() {
			cacheInvalidate({ dataTable: 'mind', server: MIND_SERVER });
			(document.getElementById('admin-mind') as any)?._dcLoad?.(true);
		}

		document.addEventListener('astro:page-load', () => {
			const el = document.getElementById('admin-mind');
			if (el) (el as any).schema = schema((el as any).lang || 'vi');

			const syncSel     = document.getElementById('mind-sync-table') as any;
			const csvCategory = document.getElementById('mind-csv-category') as any;
			customElements.whenDefined('web-select').then(() => {
				if (syncSel && syncSel.value == null)     syncSel.value = 'products';
				if (csvCategory && csvCategory.value == null) csvCategory.value = 'other';
			});

			// Case 1 — chọn 1 bảng có sẵn (products/posts), đồng bộ lại TOÀN BỘ record của bảng đó vào
			// `mind` (idempotent — an toàn bấm nhiều lần, xem tools/mind-sync.js's syncMindFromOutputTable).
			const syncBtn = document.getElementById('mind-sync-btn') as any;
			if (syncBtn && !syncBtn.dataset.wired) {
				syncBtn.dataset.wired = '1';
				syncBtn.addEventListener('clicked', async () => {
					const table = syncSel?.value || 'products';
					syncBtn.loading = true;
					try {
						const rows = await createService(table).findAll() as any[];
						for (const r of rows) await syncMindFromOutputTable(r, table);
						reloadMindGrid();
						toastEmit(`Đã đồng bộ ${rows.length} bản ghi từ "${table}"`, 'success');
					} catch (err: any) {
						toastEmit(`Đồng bộ thất bại: ${err.message}`, 'error');
					} finally {
						syncBtn.loading = false;
					}
				});
			}

			// Case 2 — nhập CSV ngoài: chọn unitType ÁP DỤNG CHO CẢ FILE trước, cột CỐ ĐỊNH thứ tự
			// title|description|content|tags|pricing|promo|quantity|effectiveFrom|effectiveTo (dòng
			// đầu là header thì tự bỏ qua) — 2 cột cuối OPTIONAL, rỗng = luôn có hiệu lực.
			const csvBtn   = document.getElementById('mind-csv-btn') as any;
			const csvInput = document.getElementById('mind-csv-input') as HTMLInputElement;
			if (csvBtn && !csvBtn.dataset.wired) {
				csvBtn.dataset.wired = '1';
				csvBtn.addEventListener('clicked', () => csvInput?.click());
				csvInput?.addEventListener('change', async () => {
					const file = csvInput.files?.[0];
					if (!file) return;
					csvBtn.loading = true;
					try {
						const csvText = await file.text();
						const rows = parseCsvRows(csvText.replace(/^﻿/, '')).filter(r => r.some((c: string) => c.trim() !== ''));
						const hasHeader = rows.length > 0 && (rows[0][0] || '').trim().toLowerCase() === 'title';
						const dataRows = hasHeader ? rows.slice(1) : rows;
						const svc = createService('mind', '', MIND_SERVER);
						const now = await svc.now();
						const unitType = csvCategory?.value || 'other';
						let ok = 0;
						for (const cols of dataRows) {
							const [title, description, content, tags, pricing, promo, quantity, effectiveFrom, effectiveTo] = cols;
							if (!title?.trim()) continue;
							const text = buildExternalSearchText({
								title: (title || '').trim(), description: (description || '').trim(),
								content: (content || '').trim(), tags: (tags || '').trim(),
								pricing: (pricing || '').trim(), promo: (promo || '').trim(),
								quantity: (quantity || '').trim(),
							});
							await svc.create({
								domain: DOMAIN_SALE, unitType, refTable: '', refId: '',
								text,
								version: '1',
								status: 'active',
								effectiveFrom: (effectiveFrom || '').trim() || null,
								effectiveTo: (effectiveTo || '').trim() || null,
								authorityLevel: (AUTHORITY_BY_UNIT_TYPE as Record<string, number>)[unitType] ?? AUTHORITY_BY_UNIT_TYPE.other,
								embedding: [],
								created_at: now, updated_at: now, deleted_at: null,
							});
							ok++;
						}
						reloadMindGrid();
						toastEmit(`Đã nhập ${ok} dòng từ CSV`, 'success');
					} catch (err: any) {
						toastEmit(`Nhập CSV thất bại: ${err.message}`, 'error');
					} finally {
						csvBtn.loading = false;
						csvInput.value = '';
					}
				});
			}
		});
	</script>
</LayoutAdmin>
