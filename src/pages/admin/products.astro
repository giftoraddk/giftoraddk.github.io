---
import LayoutAdmin from '@/layouts/LayoutAdmin.astro';
const pageTitle = 'Products Admin';
const pageDescription = 'Products admin page';
---

<LayoutAdmin title={pageTitle} description={pageDescription}>
	<div class='p-4'>
		<h1 class='text-xl font-bold mb-5'>Quản lý sản phẩm</h1>
		<svc-admin id='admin-products' dataTable='products' lang='vi' orderable revalidate></svc-admin>
	</div>

	<script>
		import '@/webs/auth/svc-admin.js';
		import schema from '@/services/schemas/admin/products.js';

		document.addEventListener('astro:page-load', () => {
			const el = document.getElementById('admin-products');
			if (el) (el as any).schema = schema((el as any).lang || 'vi');
		});
	</script>
</LayoutAdmin>
