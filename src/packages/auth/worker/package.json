{
  "name": "auth",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup-dev.mjs && node scripts/push-secrets.mjs",
    "predev": "node scripts/setup-dev.mjs && pnpm run db:local",
    "dev": "wrangler dev --port 8787 --inspector-port 9229",
    "deploy": "pnpm run db:remote && wrangler deploy",
    "db:local": "node ../../../../scripts/d1-schema.mjs ALL_DB --local",
    "db:remote": "node ../../../../scripts/d1-schema.mjs ALL_DB --remote",
    "db:wipe": "node ../../../../scripts/d1-wipe.mjs ALL_DB",
    "typecheck": "tsc --noEmit",
    "paypal:plans": "node scripts/paypal-plans.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250913.0",
    "typescript": "^5.6.3",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "jose": "^5.9.6"
  }
}
