---
import LayoutAdmin from '@/layouts/LayoutAdmin.astro';
const pageTitle = 'Divisions Admin';
const pageDescription = 'Divisions admin page';
---

<LayoutAdmin title={pageTitle} description={pageDescription}>
	<div class='p-4'>
		<h1 class='text-xl font-bold mb-5'>Quản lý phòng ban</h1>
		<svc-admin id='admin-divisions' dataTable='divisions' lang='vi' orderable></svc-admin>
	</div>

	<script>
		import '@/webs/auth/svc-admin.js';
		import schema from '@/services/schemas/admin/divisions.js';

		document.addEventListener('astro:page-load', () => {
			const el = document.getElementById('admin-divisions');
			if (el) (el as any).schema = schema((el as any).lang || 'vi');
		});
	</script>
</LayoutAdmin>
