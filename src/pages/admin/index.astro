---
import LayoutAdmin from '@/layouts/LayoutAdmin.astro';
const pageTitle = 'Users Admin';
const pageDescription = 'Users admin page';
---

<LayoutAdmin title={pageTitle} description={pageDescription}>
	<div class='p-4'>
		<h1 class='text-xl font-bold mb-5'>Quản lý người dùng</h1>
		<svc-admin id='admin-users' dataTable='users' server='auth' lang='vi' orderable></svc-admin>
	</div>

	<script>
		import '@/webs/auth/svc-admin.js';
		import schema from '@/services/schemas/admin/users.js';

		document.addEventListener('astro:page-load', () => {
			const el = document.getElementById('admin-users');
			if (el) (el as any).schema = schema((el as any).lang || 'vi');
		});
	</script>
</LayoutAdmin>
