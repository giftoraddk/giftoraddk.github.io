---
import ActionBtnTheme from "@/components/Nav/Action/BtnTheme.astro";
import { Image } from "astro:assets";

const {
	root = "",
	logo = "/logo.png",
	logoText,
	class: className = "",
} = Astro.props;
---

<aside
	class={`z-1 relative w-64 border-r border-b border-base-content/10 h-screen overflow-y-auto p-3 text-base-content ${className}`}
>
	<div class="h-full w-full flex flex-col justify-between gap-4">
		<!-- prefix -->
		<div>
			<div class="md:flex md:items-center md:justify-between md:gap-4">
				<a href={"/"}>
					<Image
						class="fliping-circle"
						src={logo}
						width={48}
						height={48}
						format="png"
						alt="logo"
					/>
					<span class="hidden md:block text-2xl font-semibold">
						{logoText}
					</span>
				</a>
				<ActionBtnTheme />
			</div>
			<slot name="prefix" />
		</div>
		<!-- center -->
		<div class="flex-1">
			<slot />
		</div>

		<!-- suffix -->
		<div class="flex items-center gap-2">
			<slot name="suffix" />
		</div>
	</div>
</aside>
