---
import "../styles/themes/default.css";
import { ClientRouter, slide } from "astro:transitions";
import Head from "@/components/Head/Base.astro";
import NavBase from "@/components/Nav/Base.astro";
const {
	title,
	description,
	image,
	articleDate,
	menu = { type: "side" },
	extendClass = "",
} = Astro.props;
const root = "/";

const menuItems = [
	{
		text: "All components",
		textIcon: "A",
		// childs
		items: [
			{ text: "Modern style", href: root + "ui" },
			{ text: "Pastel style", href: root + "ui/pastel" },
		],
	},
	{ text: "Sandbox", textIcon: "SB", href: root + "ui/sandbox" },
	{ text: "Underlay", textIcon: "UL", href: root + "ui/underlay" },
	{ text: "Slider", textIcon: "SL", href: root + "ui/slider" },
	{ text: "Product Style", textIcon: "MU", href: root + "ui/product-style" },
];
const wrapClass = [
	"bg-base-100",
	menu.type === "side" ? "flex-1 flex flex-row overflow-y-hidden" : "",
	extendClass,
]
	.filter(Boolean)
	.join(" ");
const mainClass = [
	menu.type === "side" ? "flex-1 overflow-x-hidden overflow-y-auto" : "",
]
	.filter(Boolean)
	.join(" ");
---

<html lang="en" class="scroll-smooth scrollbar-hide" data-theme="light">
	<head>
		<ClientRouter />
		<Head
			title={title}
			description={description}
			ogImage={image}
			articleDate={articleDate}
		/>
	</head>

	<body transition:animate={slide({ duration: "0.5s" })}>
		<div class="min-h-dvh h-dvh flex flex-col text-base-content">
			<div id="main-wrap" class={wrapClass}>
				<NavBase 
					type={menu.type} 
					logoText="" 
					items={menuItems} 
					menuClass="py-8 -mx-3"
				/>
				<main id="main" class={mainClass}>
					<slot />
				</main>
			</div>
		</div>
	</body>
	<style>
		[data-theme="light"] .bg-wrap{
			background-image: url('/images/common/bg-light.webp');
			background-size: cover;
			background-position: center;
		}
		[data-theme="dark"] .bg-wrap{
			background-image: url('/images/common/bg-dark.webp');
			background-size: cover;
			background-position: center;
		}
	</style>
</html>
