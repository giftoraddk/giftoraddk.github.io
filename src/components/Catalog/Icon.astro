---
// Icon SVG inline (stroke, 24×24) cho bộ giao diện catalog (post / product) — render sẵn lúc SSR nên có mặt ngay cả khi
// không chạy JS (khác iconify-icon tải icon lúc runtime). Trang trí → luôn aria-hidden; nhãn đặt ở phần tử cha.
interface Props { name: keyof typeof PATHS; size?: number; class?: string }

const PATHS = {
	search:   '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>',
	close:    '<path d="M18 6 6 18M6 6l12 12"/>',
	back:     '<path d="m15 18-6-6 6-6"/>',
	next:     '<path d="m9 18 6-6-6-6"/>',
	home:     '<path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>',
	tag:      '<path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1.5"/>',
	up:       '<path d="M12 19V5M5 12l7-7 7 7"/>',
	share:    '<path d="M4 12v7a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7"/><path d="m16 6-4-4-4 4M12 2v13"/>',
	heart:    '<path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21l7.8-7.5 1-1.1a5.5 5.5 0 0 0 0-7.8z"/>',
	eye:      '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"/><circle cx="12" cy="12" r="3"/>',
	clock:    '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
	pin:      '<path d="M12 21s-7-6.2-7-12a7 7 0 0 1 14 0c0 5.8-7 12-7 12z"/><circle cx="12" cy="9" r="2.5"/>',
	star:     '<path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z"/>',
	calendar: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>',
	sort:     '<path d="M3 6h13M3 12h9M3 18h5M17 8v12M14 17l3 3 3-3"/>',
	layers:   '<path d="m12 2 10 5-10 5L2 7z"/><path d="m2 17 10 5 10-5M2 12l10 5 10-5"/>',
	grid:     '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
	inbox:    '<path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5.5 5.1 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.5-6.9A2 2 0 0 0 16.8 4H7.2a2 2 0 0 0-1.7 1.1z"/>',
	check:    '<path d="M20 6 9 17l-5-5"/>',
	bag:      '<path d="M6 7h12l1 13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1z"/><path d="M9 10V6a3 3 0 0 1 6 0v4"/>',
	link:     '<path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/>',
	filter:   '<path d="M3 5h18M6 12h12M10 19h4"/>',
	trend:    '<path d="m3 17 6-6 4 4 8-8"/><path d="M14 7h7v7"/>',
	cart:     '<circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M2 3h3l2.6 12.2a1 1 0 0 0 1 .8h9.7a1 1 0 0 0 1-.8L21 7H6.1"/>',
	down:     '<path d="m6 9 6 6 6-6"/>',
	chat:     '<path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/>',
	sparkle:  '<path d="M10 3.5 11.6 8a3 3 0 0 0 1.9 1.9L18 11.5l-4.5 1.6a3 3 0 0 0-1.9 1.9L10 19.5 8.4 15a3 3 0 0 0-1.9-1.9L2 11.5l4.5-1.6A3 3 0 0 0 8.4 8z"/><path d="M18.5 2.5v4M16.5 4.5h4"/>',
	// Logo thương hiệu — vẽ bằng fill (xem FILLED)
	facebook: '<path d="M14 13.5h2.5l1-4H14v-2c0-1.03 0-2 2-2h1.5V2.14c-.33-.04-1.56-.14-2.86-.14C11.93 2 10 3.66 10 6.7v2.8H7v4h3V22h4z"/>',
	x:        '<path d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.65l-5.21-6.82-5.97 6.82H1.68l7.73-8.84L1.25 2.25h6.83l4.71 6.23zm-1.16 17.52h1.83L7.08 4.13H5.12z"/>',
	tiktok:   '<path d="M16 8.25v7.25a6.5 6.5 0 1 1-5-6.33v3.17a3.5 3.5 0 1 0 2 3.16V2h3a5 5 0 0 0 5 5v3a7.97 7.97 0 0 1-5-1.75z"/>',
} as const;

const FILLED = new Set(['facebook', 'x', 'tiktok']);

const { name, size = 20, class: cls = '' } = Astro.props;
const filled = FILLED.has(name);
---

<svg class={`pf-ico ${cls}`} width={size} height={size} viewBox="0 0 24 24"
	fill={filled ? 'currentColor' : 'none'} stroke={filled ? 'none' : 'currentColor'}
	stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"
	set:html={PATHS[name]} />
