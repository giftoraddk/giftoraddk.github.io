---
// '/' — trang chủ Giftora DDK (quà tặng doanh nghiệp). giftoraddk.com chỉ bán quà tặng, nên trang chính nằm thẳng ở gốc
// domain: URL nhận nhiều link + tìm kiếm thương hiệu nhất, và là trang AI crawler đọc đầu tiên — chúng chỉ đọc HTML 1 lần,
// không theo redirect/refresh, nên nội dung phải ở ngay đây. /gift chỉ còn chuyển về '/' (redirects, astro.config.mjs);
// các trang con /gift/<danh mục>, /gift/<ngân sách>, /gift/service/*, /gift/policy/*, /gift/shop giữ nguyên.
// Nội dung: src/modules/gift/index.js; meta + CTA: modules/gift/meta.js; khung kiểu tints: modules/gift/shop.js `tintsChrome`.
// Kiến thức của trợ lý: public/data/gift.json.
import Core from '@/layouts/Core.astro';
import BoardOutline from '@/components/Seo/BoardOutline.astro';
import GiftAide from '@/components/Gift/Aide.astro';
import { getViews } from '@/modules/gift/index.js';
import { tintsChrome } from '@/modules/gift/shop.js';
import { page } from '@/modules/gift/meta.js';
import { GIFT_GROUPS, siteNavLd } from '@/modules/gift/nav.js';
import { company, companyHours, companyPostalAddress } from '@/modules/company.js';
import { boardPageSeo } from '@/packages/apex/tool/board-seo.js';

const views = await getViews();
const currentView = views.find((v) => v.href === '/') ?? views[0];

// SEO/GEO — web-board chỉ render ở client; outline + JSON-LD dựng từ CHÍNH sections để crawler không chạy JS đọc được
// (best-seller thật lấy lúc build → ItemList, quy trình → HowTo, câu hỏi → FAQPage).
const seo = boardPageSeo(page, currentView.sections, Astro.site ?? Astro.url);
const base = seo.url.replace(/\/$/, '');
// WebSite + SiteNavigationElement (modules/gift/nav.js): tên site + các mục con được index — tín hiệu cho sitelinks.
// Store: cửa hàng thật (địa chỉ, giờ mở cửa, liên hệ) gắn về Organization của Head/Base.astro qua cùng @id; danh mục,
// mức ngân sách và dịch vụ thành OfferCatalog — AI Search trả lời "bán gì / ở đâu / mấy giờ / gọi số nào".
const jsonLd = [
	...seo.jsonLd,
	...siteNavLd(),
	{
		'@context': 'https://schema.org',
		'@type': 'Store',
		'@id': `${base}/#store`,
		name: page.name,
		description: page.description,
		url: seo.url,
		image: new URL('/images/common/gift-main.webp', seo.url).href,
		telephone: company.hotline,
		email: company.email,
		address: companyPostalAddress,
		areaServed: { '@type': 'Country', name: 'Việt Nam' },
		currenciesAccepted: 'VND',
		paymentAccepted: 'Chuyển khoản ngân hàng, Tiền mặt (COD)',
		openingHoursSpecification: companyHours.map((h) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: h.days, opens: h.opens, closes: h.closes })),
		parentOrganization: { '@id': `${base}/#organization` },
		hasOfferCatalog: {
			'@type': 'OfferCatalog',
			name: 'Quà tặng doanh nghiệp',
			itemListElement: GIFT_GROUPS.slice(0, 3).map((g) => ({
				'@type': 'OfferCatalog',
				name: g.title,
				itemListElement: g.links.map((l) => ({ '@type': 'OfferCatalog', name: l.name, description: l.description, url: `${base}${l.path}` })),
			})),
		},
	},
];
---

<Core
	{...tintsChrome}
	title={page.title}
	description={page.description}
	image="/images/common/gift-dark.webp"
	lang={page.lang}
	noindex={!page.indexable}
	jsonLd={jsonLd}
>
	<script src='@/packages/apex/web-board.js'></script>
	<div>
		<web-board
			unlock={import.meta.env.PUBLIC_EXP}
			variant={JSON.stringify(tintsChrome.variant)}
		><script type="application/json" is:inline set:html={JSON.stringify(currentView.sections)}></script><BoardOutline outline={seo.outline} /></web-board>
	</div>

	<GiftAide theme={tintsChrome.theme} lang={page.lang} />
</Core>
