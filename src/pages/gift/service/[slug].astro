---
// /gift/service/<slug> — 1 trang / dịch vụ (modules/gift/services.js), mỗi dịch vụ tự định nghĩa `sections` riêng.
import CoreShop from '@/layouts/CoreShop.astro';
import BoardOutline from '@/components/Seo/BoardOutline.astro';
import GiftAide from '@/components/Gift/Aide.astro';
import { tintsChrome, tintsSections, shop } from '@/modules/gift/shop.js';
import { services } from '@/modules/gift/services.js';
import { SITE, GIFT_LANG, GIFT_HOME } from '@/modules/gift/meta.js';
import { company } from '@/modules/company.js';
import { boardPageSeo } from '@/packages/apex/tool/board-seo.js';

export function getStaticPaths() {
	return services.map((svc) => ({ params: { slug: svc.slug }, props: { svc } }));
}

const { svc } = Astro.props;
const page = { path: Astro.url.pathname, lang: GIFT_LANG, ...svc.seo };
const base = SITE.replace(/\/$/, '');
// Kiểu tints như trang chủ: tắt <svc-underlay> + ảnh nền bg-wrap của layout (tintsChrome) và bg của từng section.
const sections = tintsSections(svc.sections);

// SEO/GEO — outline + WebPage/BreadcrumbList/HowTo (section quy trình `steps`) từ chính sections của dịch vụ, thêm
// Service (provider = Organization của Head/Base.astro, cùng @id) để AI Search hiểu đây là 1 dịch vụ cung cấp,
// không chỉ 1 bài viết.
const seo = boardPageSeo(page, svc.sections, Astro.site ?? Astro.url, {
	breadcrumb: [GIFT_HOME, { name: svc.title.vi, path: page.path }],
});
const jsonLd = [
	...seo.jsonLd,
	{
		'@context': 'https://schema.org',
		'@type': 'Service',
		name: svc.title.vi,
		serviceType: svc.seo.title,
		description: svc.seo.description,
		url: seo.url,
		areaServed: { '@type': 'Country', name: 'Việt Nam' },
		provider: { '@type': 'Organization', '@id': `${base}/#organization`, name: company.name.vi, url: SITE },
	},
];
---

<CoreShop {...tintsChrome} shop={shop} title={page.title} description={page.description} lang={page.lang} jsonLd={jsonLd} image="/images/common/gift-light.webp">
	<script src='@/packages/apex/web-board.js'></script>
	<div>
		<web-board
			unlock={import.meta.env.PUBLIC_EXP}
			variant={JSON.stringify(tintsChrome.variant)}
		><script type="application/json" is:inline set:html={JSON.stringify(sections)}></script><BoardOutline outline={seo.outline} /></web-board>
	</div>

	<GiftAide theme={tintsChrome.theme} lang={page.lang} />
</CoreShop>
