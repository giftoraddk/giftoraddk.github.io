{
  "name": "llm",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup-dev.mjs && node scripts/push-secrets.mjs",
    "predev": "node scripts/setup-dev.mjs && pnpm run db:local",
    "dev": "wrangler dev --port 8788 --inspector-port 9230",
    "deploy": "pnpm run db:remote && wrangler deploy",
    "db:local": "node ../../../../scripts/d1-schema.mjs LLM_DB --local",
    "db:remote": "node ../../../../scripts/d1-schema.mjs LLM_DB --remote",
    "db:wipe": "node ../../../../scripts/d1-wipe.mjs LLM_DB",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250913.0",
    "typescript": "^5.6.3",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "jose": "^5.9.6"
  }
}
