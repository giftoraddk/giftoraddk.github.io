---
import Core from '@/layouts/Core.astro';
import { KINDS } from '@/components/Catalog/kinds';
import Feed from '@/components/Catalog/Feed.astro';
import { fetchCollection } from '@/services/core/fetcher.server.js';
import { tagSlugMap, pickLang } from '@/services/tools/util';
import { site } from '@/services/tools/site';
import { menuItems, policies, socials } from '@/modules/gift/shop.js'; // footer chung giftoraddk.com
import { menu as postMenu, tints } from '@/modules/post/index.js';

// Trang bài viết theo tag — biến thể SSG (mặc định); bản ISR ở _render-modes/[tag].isr.astro.
// Cùng giao diện Feed với /post/ (chip tag đang xem active + breadcrumb + JSON-LD CollectionPage).

export async function getStaticPaths() {
	const posts = await fetchCollection('posts');
	return [...tagSlugMap(posts).entries()].map(([slug, { label, items }]) => ({
		params: { tag: slug },
		props: { tag: label, posts: items, allPosts: posts },
	}));
}

const { tag, posts, allPosts } = Astro.props as { tag: string; posts: any[]; allPosts: any[] };
const tagSlug = Astro.params.tag as string;

const pageTitle = tag;
const pageDescription = pickLang({
	en: `${posts.length} posts about "${tag}" on ${site.subtitle}.`,
	vi: `${posts.length} bài viết về "${tag}" tại ${site.subtitle}.`,
});
const breadcrumb = [
	{ label: pickLang({ en: 'Home', vi: 'Trang chủ' }), href: '/' },
	{ label: pickLang({ en: 'Posts', vi: 'Bài viết' }), href: '/post/' },
	{ label: pickLang({ en: 'Topics', vi: 'Chủ đề' }), href: '/post/tag/' },
	{ label: tag },
];
const image = posts.map((p: any) => String(p.pics || '').split('|').find(Boolean)).find(Boolean);
const bg = null;
---

<Core menu={postMenu} tints={tints} title={`${pageTitle} • ${pickLang({ en: 'Posts', vi: 'Bài viết' })}`} description={pageDescription} image={image} footer={{ columns: menuItems, policies, socials, bg }}>
	<Feed kind={KINDS.post} items={posts} allItems={allPosts} title={pageTitle} description={pageDescription}
		path={`/post/tag/${tagSlug}/`} activeTag={tagSlug} breadcrumb={breadcrumb} />
</Core>
