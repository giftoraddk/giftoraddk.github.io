{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "auth",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],

  // Only non-secret config goes here. SUPABASE_SERVICE_ROLE_KEY / PAYPAL_CLIENT_ID / PAYPAL_CLIENT_SECRET /
  // PAYPAL_WEBHOOK_ID are set with `wrangler secret put` (see scripts/push-secrets.mjs).
  "vars": {
    "ALLOWED_ORIGIN": "https://chatzui.com,https://www.chatzui.com,https://giftoraddk.com,https://www.giftoraddk.com,http://localhost:5000",
    "SUPABASE_URL": "https://epiwtyryvbqnsvcossjb.supabase.co",
    // Gốc của PayPal return_url / cancel_url (/system/pricing) + link dự phòng trong tin Telegram Zap Share (zap.ts lấy
    // Origin của trang nếu có trong ALLOWED_ORIGIN). Local dev lấy APP_URL từ .dev.vars (scripts/setup-dev.mjs).
    "APP_URL": "https://chatzui.com",
    // 'sandbox' | 'live' — chọn host API PayPal + planIds trong purchase/tool/plans.js; phải khớp
    // loại app của PAYPAL_CLIENT_ID. Local dev lấy từ .dev.vars.
    "PAYPAL_ENV": "sandbox"
  },
  
  // Bảng nội dung của app (DB_ALL) — document store, schema ở db/schema.sql (tự đồng bộ khi dev/deploy) + quyền ở src/tables.ts
  "d1_databases": [
    {
      "binding": "ALL_DB",
      "database_name": "mini",
      "database_id": "3a9dcef5-c450-4918-95c2-b4ce436032cd"
    }
  ],
}
