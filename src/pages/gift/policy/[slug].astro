---
// /gift/policy/<slug> — 4 chính sách công ty (thanh toán, vận chuyển, đổi trả/hoàn tiền, bảo mật), nội dung song ngữ ở
// modules/gift/policies.js — HTML tĩnh (article bên dưới), crawler đọc thẳng, không cần outline của web-board.
import Core from '@/layouts/Core.astro';
import I18nText from '@/components/I18nText.astro';
import GiftAide from '@/components/Gift/Aide.astro';
import { chrome } from '@/modules/gift/shop.js';
import { policies } from '@/modules/gift/policies.js';
import { GIFT_LANG, GIFT_HOME } from '@/modules/gift/meta.js';
import { breadcrumbJsonLd } from '@/packages/apex/tool/board-seo.js';

export function getStaticPaths() {
	return policies.map((doc) => ({ params: { slug: doc.slug }, props: { doc } }));
}

const { doc } = Astro.props;

// Nội dung đã là HTML tĩnh — chỉ cần WebPage + BreadcrumbList.
const base = Astro.site ?? Astro.url;
const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebPage',
		name: doc.title.vi,
		description: doc.intro?.vi,
		url: new URL(Astro.url.pathname, base).href,
		inLanguage: GIFT_LANG,
	},
	breadcrumbJsonLd([GIFT_HOME, { name: doc.title.vi, path: Astro.url.pathname }], base),
];
---

<Core {...chrome} title={doc.title.vi} description={doc.intro?.vi} lang={GIFT_LANG} jsonLd={jsonLd}>
	<article class='mx-auto max-w-3xl px-4 py-16'>
		<h1 class='text-3xl font-bold text-base-content mb-4'><I18nText text={doc.title} /></h1>
		{doc.intro && <p class='text-base-content/70 mb-10'><I18nText text={doc.intro} /></p>}

		{doc.sections.map((sec: { heading: any; blocks: any[] }) => (
			<section class='mb-8'>
				<h2 class='text-xl font-semibold text-base-content mb-3'><I18nText text={sec.heading} /></h2>
				{sec.blocks.map((b) => (
					b.items ? (
						<ul class='list-disc pl-5 space-y-1 text-base-content/80 mb-3'>
							{b.items.map((it: any) => <li><I18nText text={it} /></li>)}
						</ul>
					) : b.text?.vi ? (
						<p class='text-base-content/80 mb-3'>
							{b.label && <strong class='text-base-content'><I18nText text={b.label} />: </strong>}
							<I18nText text={b.text} />
						</p>
					) : (
						<p class='font-semibold text-base-content mb-2'><I18nText text={b.label} /></p>
					)
				))}
			</section>
		))}
	</article>

	<GiftAide theme={chrome.theme} lang={GIFT_LANG} />
</Core>
