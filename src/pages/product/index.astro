---
import Core from '@/layouts/Core.astro';
import List from '@/components/Common/List.astro';
import { config as cardConfig } from '@/sections/another/_cardProductSeo.js';
import { fetchCollection } from '@/services/firestore.server.ts';
import { productSlug } from '@/services/helper.js';
import { menuItems, policies, socials } from '@/modules/landing/home.js';

// Trang catalog CRAWLABLE cho products — song song với /shop (cart UI 100% client-side, xem
// hook/geo-platform-plan.md §B0). Cùng khung với src/pages/post/index.astro — UI/hạ tầng
// search+sort+infinite-scroll dùng chung qua Common/List.astro. KHÔNG có add-to-cart ở đây —
// trang này chỉ để crawl/đọc, mua hàng vẫn qua /shop.

const pageTitle = 'Danh sách sản phẩm';
const pageDescription = 'Khám phá toàn bộ sản phẩm';

// meta.url được inject để _cardProductSeo.js tạo link /product/{slug} (từ khoá, xem productSlug)
const products = (await fetchCollection('products')).map((p) => ({
	...p,
	meta: { ...(p.meta ?? {}), url: `/product/${productSlug(p)}/`, ctaLabel: 'Xem chi tiết' },
}));

const sortOptions = [
	{ label: 'Mới nhất', value: 'newest', field: 'created_at', transform: 'date', order: 'desc' },
	{ label: 'Giá tăng dần', value: 'price_asc', field: 'pricing', transform: 'pipeFirstNum', order: 'asc' },
	{ label: 'Giá giảm dần', value: 'price_desc', field: 'pricing', transform: 'pipeFirstNum', order: 'desc' },
	{ label: 'Đánh giá cao nhất', value: 'rating', field: 'score', transform: 'pipeFirstNum', order: 'desc' },
];

const bg = { blur: true, gradient: true, tint: '#2ebd85', total: 3, blobType: 'circleOverlap', blobMove: 'swap', deg: 180 };
---

<Core title={pageTitle} description={pageDescription} footer={{ columns: menuItems, policies, socials, bg }}>
	<List
		pageTitle={pageTitle}
		pageDescription={pageDescription}
		items={products}
		cardConfig={cardConfig}
		dataTable="products"
		urlPrefix="/product/"
		extraMeta={{ ctaLabel: 'Xem chi tiết' }}
		searchPlaceholder="Tìm kiếm sản phẩm..."
		sortOptions={sortOptions}
		bottomCta={{ href: '/gift/shop', label: 'Đặt mua trên cửa hàng' }}
	/>
</Core>
