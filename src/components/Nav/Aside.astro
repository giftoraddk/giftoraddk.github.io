---
// Menu trái cho desktop (lg+) của layouts/CoreMobile.astro `aside` — dưới lg thanh đáy Nav/Mobile.astro đảm nhận, ở đây
// ẩn. Cùng ngôn ngữ bottom sheet của Nav/Mobile.astro / panel svc-node: quầng tints [a, b] 2 góc (--layout-tint-a/b),
// viền mảnh, glyph vuông gradient a→b, mục đang mở nền a nhạt + chấm gradient — không shadow. Cùng định dạng `items`
// (text song ngữ, href, iconMobile | icon | textIcon) và cùng data-nav-href để trang lọc mục theo quyền như thanh đáy.
import ActionBtnTheme from "@/components/Nav/Action/BtnTheme.astro";
import I18nText from "@/components/I18nText.astro";
import { plainText } from "@/services/tools/util";
import "iconify-icon";

const { items = [], title = "", icon = "ri:apps-2-line", home = "/" } = Astro.props;

const norm = (href = "") => href.replace(/\/$/, "") || "/";
const current = norm(Astro.url.pathname);
---

<aside class="nav-aside" aria-label="Menu">
	<!-- Nút theme nằm cạnh link (không lồng trong <a>: phần tử tương tác không được nằm trong link). -->
	<div class="nav-aside-brand">
		<a class="nav-aside-home" href={home}>
			<span class="nav-aside-glyph is-lg" aria-hidden="true"><iconify-icon icon={icon} /></span>
			<span class="nav-aside-title"><I18nText text={title} /></span>
		</a>
		<div class="nav-aside-theme"><ActionBtnTheme /></div>
	</div>

	<nav class="nav-aside-scroll">
		<ul class="nav-aside-list">
			{items.map((it) => {
				const on = norm(it.href) === current;
				return (
					<li>
						<a href={it.href} data-nav-href={it.href} class:list={["nav-aside-item", { "is-active": on }]} aria-current={on ? "page" : undefined}>
							<span class="nav-aside-glyph" aria-hidden="true">
								{it.iconMobile || it.icon ? <iconify-icon icon={it.iconMobile || it.icon} /> : <span>{it.textIcon || (plainText(it.text) || "A").slice(0, 2)}</span>}
							</span>
							<span class="nav-aside-text"><I18nText text={it.text} /></span>
						</a>
					</li>
				);
			})}
		</ul>
	</nav>
</aside>

<style>
	.nav-aside {
		--a: var(--layout-tint-a, var(--color-primary));
		--b: var(--layout-tint-b, var(--color-secondary));
		--line: color-mix(in oklab, var(--color-base-content) 9%, transparent);
		--surface: color-mix(in oklab, var(--color-base-content) 5%, transparent);
		--muted: color-mix(in oklab, var(--color-base-content) 55%, transparent);
		position: fixed;
		inset: 12px auto 12px 12px;
		z-index: 100;
		display: none;
		flex-direction: column;
		width: 16rem;
		overflow: hidden;
		border-radius: 24px;
		border: 1px solid var(--line);
		color: var(--color-base-content);
		background:
			radial-gradient(220px 160px at 100% 0%, color-mix(in oklab, var(--a) 16%, transparent), transparent 70%),
			radial-gradient(180px 140px at 0% 0%, color-mix(in oklab, var(--b) 12%, transparent), transparent 70%),
			color-mix(in oklab, var(--color-base-100) 82%, transparent);
		backdrop-filter: blur(20px) saturate(1.3);
	}
	@media (min-width: 1024px) {
		.nav-aside { display: flex; }
	}

	.nav-aside-brand {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 16px 12px 14px 14px;
		border-bottom: 1px solid var(--line);
	}
	.nav-aside-home { display: flex; flex: 1; align-items: center; gap: 10px; min-width: 0; }
	.nav-aside-title { min-width: 0; font-size: 1.05rem; font-weight: 750; letter-spacing: -0.01em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

	.nav-aside-glyph {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		width: 34px;
		height: 34px;
		border-radius: 11px;
		background: linear-gradient(135deg, color-mix(in oklab, var(--a) 18%, transparent), color-mix(in oklab, var(--b) 18%, transparent));
		font-size: 0.72rem;
		font-weight: 700;
		text-transform: uppercase;
	}
	.nav-aside-glyph iconify-icon { font-size: 1.1rem; }
	.nav-aside-glyph.is-lg { width: 40px; height: 40px; border-radius: 12px; }
	.nav-aside-glyph.is-lg iconify-icon { font-size: 1.25rem; }

	.nav-aside-scroll { flex: 1; min-height: 0; overflow-y: auto; overscroll-behavior: contain; padding: 8px; scrollbar-width: thin; }
	.nav-aside-list { margin: 0; padding: 0; list-style: none; display: grid; gap: 2px; }

	.nav-aside-item {
		display: flex;
		align-items: center;
		gap: 12px;
		min-height: 46px;
		padding: 6px 8px;
		border-radius: 14px;
		color: color-mix(in oklab, var(--color-base-content) 85%, transparent);
		transition: background 0.15s ease, transform 0.15s ease;
	}
	.nav-aside-item:hover { background: var(--surface); color: var(--color-base-content); }
	.nav-aside-item:active { transform: scale(0.985); }
	.nav-aside-item:focus-visible { outline: none; box-shadow: 0 0 0 2px color-mix(in oklab, var(--a) 50%, transparent); }
	.nav-aside-text { flex: 1; min-width: 0; font-size: 0.9rem; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

	.nav-aside-item.is-active { background: color-mix(in oklab, var(--a) 12%, transparent); color: var(--color-base-content); }
	.nav-aside-item.is-active::after {
		content: '';
		flex-shrink: 0;
		width: 6px;
		height: 6px;
		margin-right: 6px;
		border-radius: 999px;
		background: linear-gradient(135deg, var(--a), var(--b));
	}

	.nav-aside-theme {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		width: 40px;
		height: 40px;
		border-radius: 999px;
		background: var(--surface);
	}

	@media (prefers-reduced-motion: reduce) {
		.nav-aside-item { transition: none; }
	}
</style>
