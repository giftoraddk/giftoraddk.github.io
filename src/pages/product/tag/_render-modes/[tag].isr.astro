---
export const prerender = false;

import Core from '@/layouts/Core.astro';
import { KINDS } from '@/components/Catalog/kinds';
import Feed from '@/components/Catalog/Feed.astro';
import { fetchCollection } from '@/services/core/fetcher.server.js';
import { pickLang } from '@/services/tools/lingo.js';
import { tagSlugMap } from '@/services/tools/util';
import { site } from '@/services/tools/site';
import { menuItems, policies, socials } from '@/modules/gift/shop.js'; // footer chung giftoraddk.com
import { menu as productMenu, tints, productSeo } from '@/modules/product/index.js';
import I18nText from '@/components/I18nText.astro';

// Biến thể ISR của src/pages/product/tag/[tag].astro — xem
// src/pages/product/_render-modes/[slug].isr.astro để biết cơ chế swap (renderModeIntegration,
// astro.config.mjs). Không có getStaticPaths — mỗi request tự fetch collection + tra tagSlugMap().

const tagSlug = Astro.params.tag as string;
const allProducts = await fetchCollection('products');
const entry = tagSlugMap(allProducts).get(tagSlug);

if (!entry) Astro.response.status = 404;

const tag = entry?.label ?? '';
const products = entry?.items ?? [];

const seo = entry ? productSeo.tag(tag, products.length) : null;
const pageTitle = seo ? pickLang(seo.heading) : pickLang({ en: 'Not found', vi: 'Không tìm thấy' });
const pageDescription = seo ? pickLang(seo.description) : '';
const breadcrumb = [
	{ label: pickLang({ en: 'Home', vi: 'Trang chủ' }), href: '/' },
	{ label: pickLang({ en: 'Products', vi: 'Sản phẩm' }), href: '/product/' },
	{ label: pickLang({ en: 'Categories', vi: 'Danh mục' }), href: '/product/tag/' },
	{ label: tag },
];
const image = products.map((p: any) => String(p.pics || '').split('|').find(Boolean)).find(Boolean);
const bg = null;
---

<Core menu={productMenu} tints={tints} title={seo ? pickLang(seo.title) : pageTitle} description={pageDescription} image={image} noindex={!entry} footer={{ columns: menuItems, policies, socials, bg }}>
	{entry ? (
		<Feed kind={KINDS.product} items={products} allItems={allProducts} title={pageTitle} description={pageDescription}
			path={`/product/tag/${tagSlug}/`} activeTag={tagSlug} breadcrumb={breadcrumb} />
	) : (
		<div class="mx-auto max-w-6xl px-4 py-24 text-center opacity-60">
			<I18nText text={{ en: 'Category not found.', vi: 'Không tìm thấy danh mục này.' }} />
		</div>
	)}
</Core>
