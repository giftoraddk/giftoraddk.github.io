---
import Core from '@/layouts/Core.astro';
import { KINDS } from '@/components/Catalog/kinds';
import Feed from '@/components/Catalog/Feed.astro';
import { fetchCollection } from '@/services/core/fetcher.server.js';
import { pickLang } from '@/services/tools/lingo.js';
import { tagSlugMap } from '@/services/tools/util';
import { site } from '@/services/tools/site';
import { menuItems, policies, socials } from '@/modules/gift/shop.js'; // footer chung giftoraddk.com
import { menu as productMenu, tints, productSeo } from '@/modules/product/index.js';

// Trang sản phẩm theo danh mục (tag) — biến thể SSG (mặc định); bản ISR ở _render-modes/[tag].isr.astro.
// Cùng giao diện Feed với /product/ (danh mục đang xem active + breadcrumb + JSON-LD CollectionPage).
// Tag thật có dấu cách/gạch chéo/hoa-thường (vd "Valentine - 14/2") → URL qua tagSlugMap() — y hệt cách
// sitemap.xml.ts/llms.txt.ts tính, tránh lệch nhau.

export async function getStaticPaths() {
	const products = await fetchCollection('products');
	return [...tagSlugMap(products).entries()].map(([slug, { label, items }]) => ({
		params: { tag: slug },
		props: { tag: label, products: items, allProducts: products },
	}));
}

const { tag, products, allProducts } = Astro.props as { tag: string; products: any[]; allProducts: any[] };
const tagSlug = Astro.params.tag as string;

const seo = productSeo.tag(tag, products.length);
const pageTitle = pickLang(seo.heading);
const pageDescription = pickLang(seo.description);
const breadcrumb = [
	{ label: pickLang({ en: 'Home', vi: 'Trang chủ' }), href: '/' },
	{ label: pickLang({ en: 'Products', vi: 'Sản phẩm' }), href: '/product/' },
	{ label: pickLang({ en: 'Categories', vi: 'Danh mục' }), href: '/product/tag/' },
	{ label: tag },
];
const image = products.map((p: any) => String(p.pics || '').split('|').find(Boolean)).find(Boolean);
const bg = null;
---

<Core menu={productMenu} tints={tints} title={pickLang(seo.title)} description={pageDescription} image={image} footer={{ columns: menuItems, policies, socials, bg }}>
	<Feed kind={KINDS.product} items={products} allItems={allProducts} title={pageTitle} description={pageDescription}
		path={`/product/tag/${tagSlug}/`} activeTag={tagSlug} breadcrumb={breadcrumb} />
</Core>
