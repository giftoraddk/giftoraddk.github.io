---
// /gift/<danh mục> — 1 trang static / danh mục quà tặng doanh nghiệp (services/shared/tags.ts): HTML chỉ chứa sản phẩm
// gắn tag của danh mục (nguyên văn hoặc theo từ khoá — categoriesOfTag), nhóm "Danh mục" của bộ lọc là link sang danh mục
// khác, các nhóm còn lại lọc ngay trên trang. Giao diện: components/Shop/Shop.astro; dữ liệu + SEO/GEO:
// modules/gift/catalog.js shopPageData.
import CoreShop from '@/layouts/CoreShop.astro';
import Shop from '@/components/Shop/Shop.astro';
import GiftAide from '@/components/Gift/Aide.astro';
import { tintsChrome, shop } from '@/modules/gift/shop.js';
import { shopPageData } from '@/modules/gift/catalog.js';
import { CATEGORY_KEYS, isCategoryKey } from '@/services/shared/tags';

// getStaticPaths() được compiler tách ra scope riêng, chỉ giữ lại import — dùng thẳng CATEGORY_KEYS đã import.
export function getStaticPaths() {
	return CATEGORY_KEYS.map((key) => ({ params: { occasions: key } }));
}

// Astro.params là `string | undefined` — isCategoryKey thu hẹp về CategoryKey (getStaticPaths chỉ sinh các key
// này, nên nhánh throw chỉ chạy khi dữ liệu/route lệch nhau — báo lỗi build thay vì ra trang rỗng). On-demand
// (PUBLIC_RENDER=isr, getStaticPaths bị bỏ qua) thì key lạ là URL lạ → 404.
const { occasions: key } = Astro.params;
if (!isCategoryKey(key)) {
	if (!Astro.isPrerendered) return new Response(null, { status: 404 });
	throw new Error(`[gift/[occasions]] danh mục không tồn tại: ${key}`);
}

const data = await shopPageData({ type: 'cat', key });
const { page } = data;
---

<CoreShop {...tintsChrome} shop={shop} title={page.title} description={page.description} lang={page.lang} jsonLd={data.jsonLd} image={page.image}>
	<Shop data={data} />
	<GiftAide theme={tintsChrome.theme} lang={page.lang} />
</CoreShop>
