---
// Phần dùng chung cho mọi trang catalog (post / product — list, tags, detail; đặt 1 lần cuối mỗi trang):
//   - time[data-rel] → "2 giờ trước" theo <html lang> (SSR chỉ in ngày tuyệt đối: build tĩnh sẽ cũ dần)
//   - [data-share]   → menu chia sẻ (Facebook / X / TikTok / Sao chép link), 1 menu dùng chung cho mọi nút
// Điều hướng nằm ở `menu` của modules/post|product/index.js truyền vào Core.astro, không ở đây.
import Icon from './Icon.astro';
import I18nText from '@/components/I18nText.astro';
import { pickLang } from '@/services/tools/lingo.js';

const label = (en: string, vi: string) => pickLang({ en, vi });
---
<div class="pf-share-menu" id="pf-share-menu" role="menu" aria-label={label('Share', 'Chia sẻ')} data-share-menu hidden>
	<a role="menuitem" data-net="facebook" target="_blank" rel="noopener noreferrer" href="#">
		<span class="pf-share-ico is-facebook"><Icon name="facebook" size={18} /></span>Facebook
	</a>
	<a role="menuitem" data-net="x" target="_blank" rel="noopener noreferrer" href="#">
		<span class="pf-share-ico is-x"><Icon name="x" size={16} /></span>X
	</a>
	<button type="button" role="menuitem" data-net="tiktok">
		<span class="pf-share-ico is-tiktok"><Icon name="tiktok" size={17} /></span>TikTok
	</button>
	<button type="button" role="menuitem" data-net="copy">
		<span class="pf-share-ico is-copy"><Icon name="link" size={17} /></span><I18nText text={{ en: 'Copy link', vi: 'Sao chép liên kết' }} />
	</button>
</div>
<div class="pf-toast" role="status" aria-live="polite" data-pf-toast></div>

<script>
	const TXT = {
		vi: { copied: 'Đã sao chép liên kết', fail: 'Không sao chép được', tiktok: 'Đã sao chép liên kết — dán vào TikTok' },
		en: { copied: 'Link copied', fail: 'Could not copy', tiktok: 'Link copied — paste it into TikTok' },
	};
	const lang = () => (document.documentElement.lang || 'vi').slice(0, 2) as 'vi' | 'en';
	const t = () => TXT[lang()] ?? TXT.vi;

	// ── Thời gian tương đối ──
	const UNITS: [Intl.RelativeTimeFormatUnit, number][] = [
		['year', 31536e3], ['month', 2592e3], ['week', 604800], ['day', 86400], ['hour', 3600], ['minute', 60],
	];

	function relTimes() {
		const rtf = new Intl.RelativeTimeFormat(lang(), { numeric: 'auto' });
		document.querySelectorAll<HTMLTimeElement>('time[data-rel]').forEach((el) => {
			const d = new Date(el.dateTime);
			if (Number.isNaN(d.getTime())) return;
			const sec = (d.getTime() - Date.now()) / 1000;
			const [unit, size] = UNITS.find(([, s]) => Math.abs(sec) >= s) ?? ['minute', 60];
			el.title ||= el.textContent?.trim() ?? '';
			el.textContent = rtf.format(Math.round(sec / size), unit);
		});
	}

	// ── Toast ──
	let toastTimer = 0;
	function toast(msg: string) {
		const el = document.querySelector<HTMLElement>('[data-pf-toast]');
		if (!el) return;
		el.textContent = msg;
		el.classList.add('is-on');
		clearTimeout(toastTimer);
		toastTimer = window.setTimeout(() => el.classList.remove('is-on'), 2200);
	}

	async function copy(text: string, msg = t().copied) {
		try { await navigator.clipboard.writeText(text); toast(msg); return true; }
		catch { toast(t().fail); return false; }
	}

	// ── Menu chia sẻ ──
	// 1 menu duy nhất mỗi trang; nút nào mở thì menu mang url/title của nút đó.
	let trigger: HTMLElement | null = null;
	let current = { url: '', title: '' };

	const menuEl = () => document.querySelector<HTMLElement>('[data-share-menu]');
	const items = (menu: HTMLElement) => [...menu.querySelectorAll<HTMLElement>('[role="menuitem"]')];

	function place(menu: HTMLElement, btn: HTMLElement) {
		const r = btn.getBoundingClientRect();
		const { offsetWidth: w, offsetHeight: h } = menu;
		const gap = 8, edge = 12;
		let top = r.bottom + gap;
		if (top + h > innerHeight - edge) top = Math.max(edge, r.top - h - gap); // không đủ chỗ bên dưới → mở lên trên
		const left = Math.min(Math.max(edge, r.right - w), innerWidth - w - edge);
		menu.style.top = `${top}px`;
		menu.style.left = `${left}px`;
		menu.dataset.up = String(top < r.top);
	}

	function openMenu(btn: HTMLElement) {
		const menu = menuEl();
		if (!menu) return;
		current = {
			url: new URL(btn.dataset.share || location.pathname, location.origin).href,
			title: btn.dataset.title || document.title,
		};
		const u = encodeURIComponent(current.url), tt = encodeURIComponent(current.title);
		menu.querySelector<HTMLAnchorElement>('[data-net="facebook"]')!.href = `https://www.facebook.com/sharer/sharer.php?u=${u}`;
		menu.querySelector<HTMLAnchorElement>('[data-net="x"]')!.href = `https://x.com/intent/tweet?url=${u}&text=${tt}`;

		trigger?.setAttribute('aria-expanded', 'false');
		trigger = btn;
		btn.setAttribute('aria-expanded', 'true');
		menu.hidden = false;
		place(menu, btn);
		requestAnimationFrame(() => menu.classList.add('is-open'));
		items(menu)[0]?.focus({ preventScroll: true });
	}

	function closeMenu(returnFocus = false) {
		const menu = menuEl();
		if (!menu || menu.hidden) return;
		menu.classList.remove('is-open');
		menu.hidden = true;
		trigger?.setAttribute('aria-expanded', 'false');
		if (returnFocus) trigger?.focus({ preventScroll: true });
		trigger = null;
	}

	async function shareTo(net: string) {
		const { url, title } = current;
		if (net === 'copy') { await copy(url); return; }
		if (net === 'tiktok') {
			// TikTok không có URL chia sẻ link như Facebook/X: điện thoại → bảng chia sẻ hệ điều hành (chọn
			// app TikTok); máy tính → chép link rồi mở tiktok.com để dán.
			if (navigator.share && matchMedia('(pointer: coarse)').matches) {
				try { await navigator.share({ title, url }); return; }
				catch (e) { if ((e as DOMException)?.name === 'AbortError') return; }
			}
			if (await copy(url, t().tiktok)) window.open('https://www.tiktok.com/', '_blank', 'noopener');
		}
	}

	// Delegation trên document — module chỉ chạy 1 lần dù ClientRouter chuyển trang
	document.addEventListener('click', (e) => {
		const target = e.target as HTMLElement;
		const menu = menuEl();

		const item = target.closest<HTMLElement>('[data-share-menu] [data-net]');
		if (item) {
			const net = item.dataset.net!;
			if (net !== 'facebook' && net !== 'x') { e.preventDefault(); shareTo(net); }
			closeMenu(); // link FB/X tự mở tab mới (target=_blank)
			return;
		}

		const btn = target.closest<HTMLElement>('[data-share]');
		if (btn) {
			e.preventDefault();
			if (trigger === btn && menu && !menu.hidden) closeMenu(true);
			else openMenu(btn);
			return;
		}

		if (menu && !menu.hidden && !menu.contains(target)) closeMenu();
	});

	document.addEventListener('keydown', (e) => {
		const menu = menuEl();
		if (!menu || menu.hidden) return;
		if (e.key === 'Escape') { e.preventDefault(); closeMenu(true); return; }
		if (e.key === 'Tab') { closeMenu(); return; }
		const list = items(menu);
		const i = list.indexOf(document.activeElement as HTMLElement);
		const go = (n: number) => { e.preventDefault(); list[(n + list.length) % list.length]?.focus(); };
		if (e.key === 'ArrowDown') go(i + 1);
		else if (e.key === 'ArrowUp') go(i - 1);
		else if (e.key === 'Home') go(0);
		else if (e.key === 'End') go(list.length - 1);
	});

	// Menu position:fixed — cuộn/đổi kích thước thì đóng thay vì để lệch khỏi nút
	document.addEventListener('scroll', () => closeMenu(), { capture: true, passive: true });
	window.addEventListener('resize', () => closeMenu());
	document.addEventListener('astro:before-swap', () => closeMenu());
	document.addEventListener('astro:page-load', relTimes);
</script>
