---
import "../styles/themes/popular.css";
import { ClientRouter, fade } from "astro:transitions";
import Head from "@/components/Head/Base.astro";
import NavBase from "@/components/Nav/Base.astro";
import UtilityBar from "@/components/Nav/Action/UtilityBar.astro";
import FooterOptimal from "@/components/Footer/Optimal.astro";
import { COOKIE_CONFIG } from "@/services/storeCookie.js";
import { site } from "@/services/constants/site.js";
// Props astro
const {
	title,
	description,
	image,
	articleDate,
	menu = {
    type: "top",
    position: "default", // default, prefix, suffix
  },
	footer = {},
	bg= {},
  theme = "light", // data-theme value, cũng là key chọn variant[theme]
	variant = {}, // { [theme]: { ui, mainColors, bgColors, textColor, bgImage } }
  shop = {
    seller: '', // name~phone~address~email~taxCode
    wallet: {},
    vietqr: {},
    cashDisabled: false,
  },
  bar = null, // { hotlineLabel, socialsLabel, socials: [{ icon, href, text }] } — không truyền thì ẩn UtilityBar
} = Astro.props;

const { ui, mainColors } = variant[theme] ?? {}; // forwarded as data-ui on <html> (spatial UI variant hook, glassmorphism etc.) + passed to the new fixed warden/stats fabs below for visual consistency with the page's configured theme

const isHorizontal = menu.type === "top" || menu.type === "bottom" || menu.type === "mobile";
const wrapClass = (isHorizontal ? "flex-col" : "flex-row") + " flex bg-base-100";
const screenClass = " h-screen overflow-y-auto overflow-x-hidden bg-wrap";

const pipeVars = (value, keys) =>
	value
		? value
				.split("|")
				.map((c) => c.trim())
				.map((c, i) => (c && keys[i] ? `--color-${keys[i]}: ${c};` : ""))
				.filter(Boolean)
				.join(" ")
		: "";

// Emit a `[data-theme]`-scoped rule per theme key in `variant` (not just the current
// `theme` prop) — so switching data-theme at runtime (cookie toggle / BtnTheme, see
// Core.astro's anti-flash script) picks up the matching colors purely via CSS cascade,
// same mechanism popular.css itself uses. A static inline `style` baked from a single
// resolved theme would freeze colors at whatever theme was active during SSR and never
// react to a later client-side data-theme change.
const themeBlock = (themeKey, cfg) => {
	if (!cfg) return "";
	const vars = [
		pipeVars(cfg.mainColors, ["primary", "secondary", "accent", "info", "warning", "success", "error"]),
		pipeVars(cfg.bgColors, ["base-100", "base-200", "base-300"]),
		pipeVars(cfg.textColor, ["base-content"]),
		cfg.bgImage ? `--bg-wrap-image: url("${cfg.bgImage}");` : "",
	]
		.filter(Boolean)
		.join(" ");
	// html[data-theme=...] (not just [data-theme=...]) — matches popular.css's own
	// [data-theme='dark'] specificity plus the element type, so this page-level
	// override reliably wins regardless of stylesheet source order.
	return vars ? `html[data-theme='${themeKey}'] { ${vars} }` : "";
};

const themeCSS = Object.entries(variant)
	.filter(([key]) => key !== "theme")
	.map(([key, cfg]) => themeBlock(key, cfg))
	.filter(Boolean)
	.join("\n");
---

<html lang={site.defaultLang} class="scroll-smooth overflow-hidden" data-theme={theme} data-ui={ui}>
	<head>
		<ClientRouter />
		<Head
			title={title}
			description={description}
			ogImage={image}
			articleDate={articleDate}
		/>
		<style set:html={themeCSS}></style>
		<!-- Apply saved theme before first paint to prevent flash -->
		<script define:vars={{ themeCookie: COOKIE_CONFIG.THEME, langCookie: COOKIE_CONFIG.LANGUAGE }} is:inline>
			(function() {
				const m = document.cookie.match(new RegExp('(?:^|; )' + themeCookie + '=([^;]*)'));
				const t = m ? decodeURIComponent(m[1]) : null;
				if (t) document.documentElement.setAttribute('data-theme', t);
				const lm = document.cookie.match(new RegExp('(?:^|; )' + langCookie + '=([^;]*)'));
				const l = lm ? decodeURIComponent(lm[1]) : null;
				if (l) document.documentElement.setAttribute('lang', l);
			})();
			// Carry theme/lang across SPA transitions before Astro swaps the new document in
			document.addEventListener('astro:before-swap', function(e) {
				const theme = document.documentElement.getAttribute('data-theme');
				if (theme) e.newDocument.documentElement.setAttribute('data-theme', theme);
				const lang = document.documentElement.getAttribute('lang');
				if (lang) e.newDocument.documentElement.setAttribute('lang', lang);
			});
		</script>
    
    <script is:inline>
      document.addEventListener('click', (e) => {
        const a = e.target.closest('a[href^="#"]')
        if (!a) return
        const id = decodeURIComponent(a.getAttribute('href').slice(1))
        const el = document.getElementById(id)
        if (!el) return
        e.preventDefault()
        const container = document.getElementById('main-wrap') ?? document.documentElement
        const top = el.getBoundingClientRect().top - container.getBoundingClientRect().top + container.scrollTop
        container.scrollTo({ top, behavior: 'smooth' })
      })
    </script>
    
    <script is:inline>
      document.addEventListener('click', (e) => {
        const a = e.target.closest('a[href^="#"]')
        if (!a) return
        const id = decodeURIComponent(a.getAttribute('href').slice(1))
        const el = document.getElementById(id)
        if (!el) return
        e.preventDefault()
        el.scrollIntoView({ behavior: 'smooth', block: 'start' })
      })
    </script>
	</head>

	<body transition:animate={fade({ duration: "0.5s" })}>
		<div
			id="main-wrap"
			class={wrapClass + (isHorizontal ? screenClass : "")}
		>
			<!-- Utility bar: chỉ render khi có prop bar -->
			{bar && (
				<UtilityBar
					hotlineLabel={bar.hotlineLabel}
					hotline={bar.hotline}
					address={bar.address}
					socialsLabel={bar.socialsLabel}
					socials={bar.socials ?? []}
				/>
			)}
			<!-- Nav -->
			<NavBase
				logoText=""
				type={menu.type}
        position={menu.position}
				class={`${menu.order || ""} ${menu.type === "bottom" ? "order-last" : ""}`}
				items={menu.menuItems}
				open={true}
				isMenu={true}
			/>
			<!-- Main -->
			<main
				id="main"
				class={`text-base-content ${menu.type === "side" ? "flex-1" + screenClass : "flex-1"}`}
			>
        <script src="@/webs/underlay/svc-underlay.js"></script>
        <svc-underlay id="main-bg" class="-mt-1" transition:persist="main-bg" {...bg}></svc-underlay>
				<div class="min-h-dvh relative">
          <slot />
        </div>
        
			  <!-- Footer -->
        {(footer.columns || footer.policies || footer.socials) && (
          <FooterOptimal
            columns={footer.columns ?? []}
            policies={footer.policies ?? []}
            socials={footer.socials ?? []}
            contact={footer.contact}
            bg={footer.bg}
          />
        )}
			</main>
      	<script src="@/webs/pay/svc-pay.js"></script>
        <svc-pay id="pay-factor" isCart position="fixed" role="buyer" transition:persist="pay-factor"
          onlyDelivery
          sellerId="01JUU9AA1EB3J1NRZEGPQXJY3B"
          seller={shop?.seller}
          wallet={JSON.stringify(shop.wallet)}
          vietqr={JSON.stringify(shop.vietqr)}
          cashDisabled={shop?.cashDisabled}
        ></svc-pay>

        <script src="@/webs/pay/svc-pay-warden.js"></script>
        <svc-pay-warden id="shop-orders-warden" position="fixed" x="99%" y="calc(100% - 13rem)"
          transition:persist="shop-orders-warden"
          ui={ui} theme={theme} mainColors={mainColors} lang="vi">
        </svc-pay-warden>

        <script src="@/webs/pay/svc-pay-stats.js"></script>
        <svc-pay-stats id="shop-stats" position="fixed" x="99%" y="calc(100% - 18.5rem)"
          transition:persist="shop-stats" style="display:none"
          ui={ui} theme={theme} mainColors={mainColors} lang="vi">
        </svc-pay-stats>

        <script src="@/webs/auth/svc-logged.js"></script>
        <svc-logged id="svc-logged" transition:persist="svc-logged" pathLink="/"></svc-logged>

		</div>

    <script>
      import { auth } from '@/webs/auth/tools/service.js';

      // Flow gán role cho <svc-pay-warden>/<svc-pay-stats> (nút fixed, xem CoreShop.astro's mount
      // ngay phía trên) — isSeller (auth.isAdmin() HOẶC user.id === sellerId, xem dưới — seller
      // của shop này chưa chắc mang cờ admin hệ thống) -> role="seller" (sellerId/wallet đọc thẳng
      // từ #pay-factor, đã đúng props qua prop `shop` của layout, tránh lặp lại 1 sellerId/wallet
      // hardcode nữa) hoặc buyer (bất kỳ ai khác, kể cả khách vãng lai chưa đăng nhập).
      // svc-pay-stats KHÔNG có chế độ buyer (chỉ seller mới có doanh thu/khách hàng để xem) — ẩn
      // hẳn khi không phải seller, cùng cách Shop.astro đã làm.
      async function applyCoreShopRole() {
        const payEl    = document.getElementById('pay-factor') as any;
        const wardenEl = document.getElementById('shop-orders-warden') as any;
        const statsEl  = document.getElementById('shop-stats') as any;
        if (!payEl) return;
        const sellerId = payEl.sellerId;
        const wallet   = payEl.wallet;
        const vietqr   = payEl.vietqr;
        const [user, isAdmin] = await Promise.all([auth.get(), auth.isAdmin()]);
        // Seller cũng có thể là 1 user thường (không mang cờ admin hệ thống) — id CHÍNH LÀ
        // sellerId hardcode của shop này thì vẫn coi như đang xem với vai trò seller, không chỉ
        // riêng auth.isAdmin() (super-admin toàn site).
        const isSeller = isAdmin || (user?.id && user.id === sellerId);

        if (wardenEl) {
          wardenEl.wallet = wallet;
          wardenEl.vietqr = vietqr; // buyer mở lại đơn CHƯA thanh toán qua nút fixed này cũng cần thấy QR, không chỉ text tài khoản — xem <svc-pay-order>/<svc-pay-valider>
          if (isSeller) {
            wardenEl.role = 'seller';
            wardenEl.sellerId = sellerId;
          } else {
            wardenEl.role = 'buyer';
            wardenEl.buyerId = user?.id ?? '';
          }
        }

        if (statsEl) {
          statsEl.style.display = isSeller ? '' : 'none';
          if (isSeller) statsEl.sellerId = sellerId;
        }
      }
      document.addEventListener('astro:page-load', applyCoreShopRole);
    </script>
	</body>
	<style>
		.bg-wrap {
			background-image: var(--bg-wrap-image, none);
			background-size: cover;
			background-position: center;
		}
	</style>
</html>
