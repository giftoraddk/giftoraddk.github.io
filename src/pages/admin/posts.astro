---
import LayoutAdmin from '@/layouts/LayoutAdmin.astro';
const pageTitle = 'Posts Admin';
const pageDescription = 'Posts admin page';
---

<LayoutAdmin title={pageTitle} description={pageDescription}>
	<div class='p-4'>
		<h1 class='text-xl font-bold mb-5'>Quản lý bài viết</h1>
		<svc-admin id='admin-posts' dataTable='posts' marketingTable='mkt' lang='vi' orderable revalidate></svc-admin>
	</div>

	<script>
		import '@/webs/auth/svc-admin.js';
		import schema from '@/services/schemas/admin/posts.js';

		document.addEventListener('astro:page-load', () => {
			const el = document.getElementById('admin-posts');
			if (el) (el as any).schema = schema((el as any).lang || 'vi');
		});
	</script>
</LayoutAdmin>
