{
  "name": "all",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "node scripts/stack.mjs setup",
    "dev": "node scripts/stack.mjs dev",
    "dev:site": "astro dev",
    "dev:auth": "node scripts/stack.mjs dev auth",
    "dev:llm": "node scripts/stack.mjs dev llm",
    "deploy": "node scripts/stack.mjs deploy",
    "deploy:auth": "node scripts/stack.mjs deploy auth",
    "deploy:llm": "node scripts/stack.mjs deploy llm",
    "check": "node scripts/stack.mjs check",
    "wipe:llm": "pnpm -C src/packages/llm/worker run db:wipe",
    "wipe:auth": "pnpm -C src/packages/auth/worker run db:wipe",
    "cf:login": "pnpm -C src/packages/auth/worker exec wrangler login",
    "cf:provision": "node scripts/stack.mjs provision",
    "paypal:plans": "pnpm -C src/packages/auth/worker run paypal:plans",
    "build": "node vite.standalone.mjs && astro build",
    "build:embed": "node vite.standalone.mjs",
    "build:zap-share": "node vite.zap-share.mjs dev",
    "build:zap-share:store": "node vite.zap-share.mjs store",
    "build:isr": "node vite.standalone.mjs && PUBLIC_RENDER=isr astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/vercel": "^11.0.10",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@supabase/supabase-js": "^2.117.2",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-color": "^3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-table-cell": "^3.31.3",
    "@tiptap/extension-table-header": "^3.31.3",
    "@tiptap/extension-table-row": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "astro": "^7.3.5",
    "codemirror": "^6.0.2",
    "echarts": "^6.1.0",
    "iconify-icon": "^3.0.3",
    "lit": "^3.3.3",
    "localforage": "^1.10.0",
    "nanostores": "^1.5.4",
    "prismjs": "^1.30.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "remark-gfm": "^4.0.1",
    "terser": "^5.51.2",
    "vite": "8.3.1"
  }
}
