---
import { site, builtUrl } from '@/services/tools/site';
import { company, companySocials, companyPostalAddress } from '@/modules/company.js';

function safeURL(path = '', base?: string | URL | null): string {
	try {
		// Absolute URL
		return new URL(path).href;
	} catch {
		try {
			// Prefer explicit base, then Astro.site, then current request origin.
			const origin = base ?? Astro.site ?? Astro.url.origin;
			return new URL(path, origin).href;
		} catch {
			// Last-resort fallback
			return '/logo.avif';
		}
	}
}

export interface Props {
	title: string;
	description?: string;
	ogImage?: string;
	articleDate?: string;
	articleModified?: string; // ISO — article:modified_time (trang bài viết)
	articleTags?: string[];   // article:tag, mỗi tag 1 thẻ meta
	// Trang redirect (vd '/gift' → '/', redirects ở astro.config.mjs) — khi có: canonical trỏ
	// THẲNG vào đích redirect (không phải trang hiện tại) đúng khuyến nghị SEO cho trang
	// redirect, + emit <meta http-equiv="refresh"> (hoạt động trên output:'static', không cần
	// adapter/Astro.redirect()). title/description vẫn mô tả ĐÚNG trang hiện tại (không phải
	// đích) — nhiều AI/search crawler chỉ đọc HTML 1 lần, không chạy JS/theo refresh, nên nội
	// dung SEO/GEO thật của trang gốc vẫn phải chuẩn.
	redirectTo?: string;
	// Trang không nên vào index (login, admin, …) — dùng thay vì disallow riêng lẻ trong robots.txt,
	// vì robots.txt chỉ chặn crawl chứ không đảm bảo gỡ khỏi index nếu trang đã bị link tới nơi khác.
	noindex?: boolean;
	// JSON-LD riêng của trang (FAQPage, HowTo, WebApplication… — vd boardJsonLd() ở
	// packages/apex/tool/board-seo.js), in thêm sau Organization; bỏ qua ở trang noindex như Organization.
	jsonLd?: object[];
	// Trang app kiểu mobile (vd /radar/*) cần 'viewport-fit=cover' để env(safe-area-inset-*) có giá trị — mặc định giữ nguyên.
	viewport?: string;
}

const { title = site.title, description = site.description, ogImage, articleDate, articleModified, articleTags = [], redirectTo, noindex = false, jsonLd = [], viewport = 'width=device-width,initial-scale=1' } = Astro.props;
// Check if Astro.site is defined
const canonicalURL = safeURL(redirectTo || Astro.url.pathname, Astro.site);

// Handle ogImage to ensure valid URL
const socialImageURL = safeURL(ogImage ?? '/logo.avif', Astro.site);

const titleSeparator = '•';
const siteTitle = `${title} ${titleSeparator} ${site.subtitle}`;

// JSON-LD Organization/WebSite (GEO) — entity gốc để AI Search/Google gắn mọi trang con
// (post/product detail…) về đúng 1 thương hiệu, thay vì tự đoán qua favicon/domain. Bỏ qua ở
// trang noindex (admin/login) — không cần quảng bá structured data ở trang không được index.
const orgJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	'@id': `${site.domain.replace(/\/$/, '')}/#organization`, // = publisherLd() / WebSite.publisher — cùng 1 entity
	name: site.subtitle,
	url: site.domain,
	logo: safeURL('/logo.avif', Astro.site),
	// Pháp nhân (modules/company.js) — tên pháp lý, MST, địa chỉ, liên hệ: AI Search trả lời "ai bán / ở đâu / gọi số nào".
	legalName: company.name.vi,
	taxID: company.taxNumber,
	email: company.email,
	telephone: company.hotline,
	address: companyPostalAddress,
	// Tài khoản mạng xã hội chính thức (modules/company.js) — giúp search/AI gắn chúng về cùng 1 thương hiệu.
	sameAs: companySocials.map((s) => s.href).filter((href) => /^https?:\/\//.test(href)),
};

// JSON-LD in qua set:html — escape '<' để chuỗi nội dung (vd câu trả lời FAQ chứa "</script>") không đóng
// sớm thẻ <script>; chuỗi escape \u003c vẫn là JSON hợp lệ, parser đọc lại đúng ký tự '<'.
const ldJson = (obj: object) => JSON.stringify(obj).replace(/</g, '\\u003c');
const ldList = noindex ? [] : [orgJsonLd, ...jsonLd];
---

<!-- Global Metadata -->
<meta charset='utf-8' />
<meta name='viewport' content={viewport} />
<link rel='icon' type='image/svg+xml' href='/favicon/favicon.ico' />
<meta name='generator' content={Astro.generator} />

<!-- Canonical URL -->
<link rel='canonical' href={canonicalURL} />

{noindex && <meta name='robots' content='noindex, nofollow' />}

{ldList.map((obj) => <script type='application/ld+json' is:inline set:html={ldJson(obj)} />)}

{redirectTo && <meta http-equiv='refresh' content={`0; url=${redirectTo}`} />}

<!-- Primary Meta Tags -->
<title>{siteTitle}</title>

<!-- SEO -->
<meta name='title' content={siteTitle} />
<meta name='description' content={description} />
<meta name='author' content={site.author} />

<!-- Open Graph / Facebook -->
<meta property='og:type' content={articleDate ? 'article' : 'website'} />
<meta property='og:url' content={Astro.url} />
<meta property='og:title' content={title} />
<meta property='og:description' content={description} />
<meta property='og:image' content={socialImageURL} />
{
	articleDate && (
		<>
			<meta property='article:author' content={site.author} />
			<meta property='article:published_time' content={articleDate} />
			{articleModified && <meta property='article:modified_time' content={articleModified} />}
			{articleTags.map((tag) => <meta property='article:tag' content={tag} />)}
		</>
	)
}

<!-- Twitter -->
<meta property='twitter:card' content='summary_large_image' />
<meta property='twitter:url' content={Astro.url} />
<meta property='twitter:title' content={title} />
<meta property='twitter:description' content={description} />
<meta property='twitter:image' content={socialImageURL} />

<!-- RSS auto-discovery -->
{builtUrl('/rss.xml') && <link rel='alternate' type='application/rss+xml' title={site.subtitle} href='/rss.xml' />}
