---
import LayoutUI from "@/layouts/LayoutUI.astro";

const pageTitle = "All Core Component";
const pageDescription = "LIT Custom Elements (Web Components)";
---

<LayoutUI title={pageTitle} description={pageDescription}>
    <script src="@/webs/apex/web-alert.js"></script>
    <script src="@/webs/apex/web-avatar.js"></script>
    <script src="@/webs/apex/web-button.js"></script>
    <script src="@/webs/apex/web-checkbox.js"></script>
    <script src="@/webs/apex/web-expansion.js"></script>
    <script src="@/webs/apex/web-dialog.js"></script>
    <script src="@/webs/apex/web-progress.js"></script>
    <script src="@/webs/apex/web-radio.js"></script>
    <script src="@/webs/apex/web-rating.js"></script>
    <script src="@/webs/apex/web-select.js"></script>
    <script src="@/webs/apex/web-table.js"></script>
    <script src="@/webs/apex/web-steps.js"></script>
    <script src="@/webs/apex/web-tabs.js"></script>
    <script src="@/webs/apex/web-toggle.js"></script>
    <script src="@/webs/apex/web-tooltip.js"></script>
    <script src="@/webs/apex/web-breadcrumb.js"></script>
    <script src="@/webs/apex/web-currency.js"></script>
    <script src="@/webs/apex/web-datetime.js"></script>
    <script src="@/webs/apex/web-dropdown.js"></script>
    <script src="@/webs/apex/web-fab.js"></script>
    <script src="@/webs/apex/web-files.js"></script>
    <script src="@/webs/apex/web-pagination.js"></script>
    <script src="@/webs/apex/web-photor.js"></script>
    <script src="@/webs/apex/web-popover.js"></script>
    <script src="@/webs/apex/web-split.js"></script>
    <script src="@/webs/apex/web-text.js"></script>
    <script src="@/webs/apex/web-textarea.js"></script>
    <script src="@/webs/apex/web-toast.js"></script>
    <script src="@/webs/media/svc-photor.js"></script>
    <script src="@/webs/graph/svc-graph.js"></script>
    <script src="@/webs/graph/svc-pie.js"></script>

    <div class="p-6">
        <h1 class="text-3xl font-bold mb-8 text-center hidden">{pageTitle}</h1>

        <div
            class="gap-8 grid md:grid-cols-2 xl:grid-cols-3 place-items-stretch"
        >
            <!-- Web Alert -->
            <figure
                class="relative group hover:bg-gray-500/5 px-4 py-6 rounded-lg place-content-center border border-white/10"
            >
                <div
                    class="badge badge-soft badge-info absolute top-0 left-0 group-hover:block hidden"
                >
                    web-alert
                </div>
                <div class="flex flex-col gap-4">
                    <web-alert theme="default" type="info">
                        This is an info alert
                    </web-alert>
                    <web-alert theme="default" type="success">
                        This is a success alert
                    </web-alert>
                    <web-alert theme="default" type="warning">
                        This is a warning alert
                    </web-alert>
                    <web-alert theme="default" type="error">
                        This is an error alert
                    </web-alert>
                </div>
            </figure>

            <!-- Web Avatar -->
            <figure
                class="relative group hover:bg-gray-500/5 px-4 py-6 rounded-lg place-content-center border border-white/10"
            >
                <div
                    class="badge badge-soft badge-info absolute top-0 left-0 group-hover:block hidden"
                >
                    web-avatar
                </div>
                <div class="flex flex-wrap place-content-center gap-4">
                    <web-avatar
                        src="https://i.pravatar.cc/150?img=1"
                        size="32px"
                        shape="square"></web-avatar>
                    <web-avatar
                        src="https://i.pravatar.cc/150?img=2"
                        size="48px"
                        shape="circle"
                        status="online"></web-avatar>
                    <web-avatar
                        src="https://i.pravatar.cc/150?img=3"
                        size="64px"
                        shape="square"
                        status="away"></web-avatar>
                    <web-avatar
                        src="https://i.pravatar.cc/150?img=4"
                        size="80px"
                        shape="circle"
                        status="busy"></web-avatar>
                    <web-avatar
                        src="https://i.pravatar.cc/150?img=5"
                        size="96px"
                        shape="square"></web-avatar>
                </div>
            </figure>

            <!-- Web Badge -->
            <figure
                class="relative group hover:bg-gray-500/5 px-4 py-6 rounded-lg place-content-center border border-white/10"
            >
                <div
                    class="badge badge-soft badge-info absolute top-0 left-0 group-hover:block hidden"
                >
                    web-button (mode="badge")
                </div>
                <div class="flex flex-wrap place-content-center gap-2">
                    <web-button mode="badge" text="Default">Default</web-button>
                    <web-button mode="badge" text="Primary" color="primary">Primary</web-button>
                    <web-button mode="badge" text="Secondary" color="secondary">Secondary</web-button>
                    <web-button mode="badge" text="Accent" color="accent">Accent</web-button>
                    <web-button mode="badge" text="Warning" color="warning">Warning</web-button>
                    <web-button mode="badge" text="Info" color="info">Info</web-button>
                    <web-button mode="badge" text="Outline" type="outline" color="primary">Outline</web-button>
                    <web-button mode="badge" text="Soft" type="soft" color="secondary">Soft</web-button>
                </div>
            </figure>

            <!-- Web Button -->
            <figure
                class="relative group hover:bg-gray-500/5 px-4 py-6 rounded-lg place-content-center border border-white/10"
            >
                <div
                    class="badge badge-soft badge-info absolute top-0 left-0 group-hover:block hidden"
                >
                    web-button
                </div>
                <div class="flex flex-wrap place-content-center gap-2">
                    <web-button>Default</web-button>
                    <web-button color="primary">Primary</web-button>
                    <web-button color="secondary">Secondary</web-button>
                    <web-button color="accent">Accent</web-button>
                    <web-button loading color="warning">Loading</web-button>
                    <web-button type="outline" disabled>Disabled</web-button>
                    <web-button type="soft" color="secondary">Soft</web-button>
                </div>
            </figure>

            <!-- Web Checkbox & Radio -->
            <figure
                class="relative group hover:bg-gray-500/5 px-4 py-6 rounded-lg place-content-center border border-white/10"
            >
                <div
                    class="badge badge-soft badge-info absolute top-0 left-0 group-hover:block hidden"
                >
                    web-checkbox & web-radio
                </div>
                <div class="flex flex-col gap-4 items-center">
                    <div class="flex gap-4">
                        <web-checkbox label="Checkbox 1"></web-checkbox>
                        <web-checkbox label="Checkbox 2" checked color="primary"
                        ></web-checkbox>
                        <web-checkbox label="Disabled" disabled></web-checkbox>
                    </div>
                    <div class="flex gap-4">
                        <web-radio name="rdDemo" label="Radio 1"></web-radio>
                        <web-radio
                            name="rdDemo"
                            label="Radio 2"
                            checked
                            color="secondary"></web-radio>
                        <web-radio name="rdDemo2" label="Disabled" disabled
                        ></web-radio>
                    </div>
                </div>
            </figure>

            <!-- Web Toggle -->
            <figure
                class="relative group hover:bg-gray-500/5 px-4 py-6 rounded-lg place-content-center border border-white/10"
            >
                <div
                    class="badge badge-soft badge-info absolute top-0 left-0 group-hover:block hidden"
                >
                    web-toggle
                </div>
                <div class="flex flex-wrap place-content-center gap-4">
                    <web-toggle value="true"></web-toggle>
                    <web-toggle value="true" color="primary"></web-toggle>
                    <web-toggle value="false" color="secondary"></web-toggle>
                    <web-toggle disabled></web-toggle>
                </div>
            </figure>

            <!-- Web Rating -->
            <figure
                class="relative group hover:bg-gray-500/5 px-4 py-6 rounded-lg place-content-center border border-white/10"
            >
                <div
                    class="badge badge-soft badge-info absolute top-0 left-0 group-hover:block hidden"
                >
                    web-rating
                </div>
                <div class="flex flex-col items-center gap-4">
                    <web-rating value="3"></web-rating>
                    <web-rating value="4" color="warning"></web-rating>
                    <web-rating value="5" color="accent" size="lg"></web-rating>
                </div>
            </figure>

            <!-- Web Progress -->
            <figure
                class="relative group hover:bg-gray-500/5 px-4 py-6 rounded-lg place-content-center border border-white/10"
            >
                <div
                    class="badge badge-soft badge-info absolute top-0 left-0 group-hover:block hidden"
                >
                    web-progress
                </div>
                <div class="flex flex-col gap-4 w-full">
                    <web-progress value="20" max="100"></web-progress>
                    <web-progress value="50" max="100" color="primary"
                    ></web-progress>
                    <web-progress value="80" max="100" color="secondary"
                    ></web-progress>
                    <web-progress value="100" max="100" color="success"
                    ></web-progress>
                </div>
            </figure>

            <!-- Web Tooltip -->
            <figure
                class="relative group hover:bg-gray-500/5 px-4 py-6 rounded-lg place-content-center border border-white/10"
            >
                <div
                    class="badge badge-soft badge-info absolute top-0 left-0 group-hover:block hidden"
                >
                    web-tooltip
                </div>
                <div class="flex flex-wrap place-content-center gap-4 py-8">
                    <web-tooltip placement="top">
                        <web-button>Hover Me (Top)</web-button>
                        <span slot="content">Tooltip Top</span>
                    </web-tooltip>
                    <web-tooltip placement="bottom" color="primary">
                        <web-button color="primary"
                            >Hover Me (Bottom)</web-button
                        >
                        <span slot="content">Tooltip Bottom</span>
                    </web-tooltip>
                </div>
            </figure>
            
            <!-- Web Dialog -->
            <figure
                class="relative group hover:bg-gray-500/5 px-4 py-6 rounded-lg place-content-center border border-white/10"
            >
                <div
                    class="badge badge-soft badge-info absolute top-0 left-0 group-hover:block hidden"
                >
                    web-dialog
                </div>
                <div class="flex flex-wrap place-content-center gap-4 py-8">
                    <web-button onclick="document.getElementById('demo-dialog').open = true" color="primary">Open Dialog</web-button>
                    <web-dialog id="demo-dialog" title="Example Dialog">
                        <div class="p-4">
                            <p>This is a custom dialog content.</p>
                            <p class="mt-2 text-sm opacity-70">You can put any HTML here.</p>
                        </div>
                        <div slot="footer" class="flex justify-end gap-2">
                            <web-button onclick="document.getElementById('demo-dialog').open = false" color="error">Cancel</web-button>
                            <web-button onclick="document.getElementById('demo-dialog').open = false" color="primary">Confirm</web-button>
                        </div>
                    </web-dialog>
                </div>
            </figure>

            <!-- Web Select -->
            <figure
                class="relative group hover:bg-gray-500/5 px-4 py-6 rounded-lg place-content-center border border-white/10"
            >
                <div
                    class="badge badge-soft badge-info absolute top-0 left-0 group-hover:block hidden"
                >
                    web-select
                </div>
                <div class="flex flex-col items-center gap-4 w-full">
                    <web-select
                        options='[{"label": "Option 1", "value": "1"}, {"label": "Option 2", "value": "2"}]'
                        placeholder="Select an option"></web-select>
                    <web-select
                        options='[{"label": "Primary", "value": "1"}, {"label": "Secondary", "value": "2"}]'
                        color="primary"
                        value="1"></web-select>
                </div>
            </figure>

            <!-- Web Expansion -->
            <figure
                class="relative group hover:bg-gray-500/5 px-4 py-6 rounded-lg place-content-center border border-white/10"
            >
                <div
                    class="badge badge-soft badge-info absolute top-0 left-0 group-hover:block hidden"
                >
                    web-expansion
                </div>
                <div class="flex flex-col w-full">
                    <web-expansion
                        panels='[{"id":"p1","label":"Expansion Item 1"},{"id":"p2","label":"Expansion Item 2"},{"id":"p3","label":"Expansion Item 3"}]'
                        active="p1"
                    >
                        <div slot="p1" class="p-4 text-sm">Content for first expansion item. It can hold any HTML element inside.</div>
                        <div slot="p2" class="p-4 text-sm">Content for second expansion item.</div>
                        <div slot="p3" class="p-4 text-sm">Content for third expansion item.</div>
                    </web-expansion>
                </div>
            </figure>

            <!-- Web Steps -->
            <figure
                class="relative group hover:bg-gray-500/5 px-4 py-6 rounded-lg place-content-center border border-white/10 md:col-span-2 xl:col-span-3"
            >
                <div class="badge badge-soft badge-info absolute top-0 left-0 group-hover:block hidden">
                    web-steps
                </div>
                <div class="w-full flex flex-col gap-8">
                    <div>
                        <p class="text-[10px] uppercase opacity-50 mb-4">With icons — active: step 3</p>
                        <web-steps
                            ui="modern"
                            active="details"
                            steps='[
                                {"id":"select",  "label":"Select Item",   "icon":"ri:cursor-line"},
                                {"id":"cart",    "label":"Add To Cart",   "icon":"ri:shopping-cart-line"},
                                {"id":"details", "label":"Fill Details",  "icon":"ri:file-list-line"},
                                {"id":"payment", "label":"Make Payment",  "icon":"ri:lock-line"},
                                {"id":"done",    "label":"Download",      "icon":"ri:file-download-line"}
                            ]'
                        >
                            <div slot="select"  class="p-4 text-sm">Select item content</div>
                            <div slot="cart"    class="p-4 text-sm">Cart content</div>
                            <div slot="details" class="p-4 text-sm">Fill details content</div>
                            <div slot="payment" class="p-4 text-sm">Payment content</div>
                            <div slot="done"    class="p-4 text-sm">Download content</div>
                        </web-steps>
                    </div>
                    <div>
                        <p class="text-[10px] uppercase opacity-50 mb-4">Without icons — active: step 2</p>
                        <web-steps
                            ui="modern"
                            isVertical
                            active="s2"
                            steps='[
                                {"id":"s1","label":"Order placed"},
                                {"id":"s2","label":"Processing"},
                                {"id":"s3","label":"Shipped"},
                                {"id":"s4","label":"Delivered"}
                            ]'
                        >
                            <div slot="s1" class="p-4 text-sm">Order placed</div>
                            <div slot="s2" class="p-4 text-sm">Processing your order…</div>
                            <div slot="s3" class="p-4 text-sm">Shipped</div>
                            <div slot="s4" class="p-4 text-sm">Delivered</div>
                        </web-steps>
                    </div>
                </div>
            </figure>

            <!-- Web Tabs -->
            <figure
                class="relative group hover:bg-gray-500/5 px-4 py-6 rounded-lg place-content-center border border-white/10 md:col-span-2 xl:col-span-3"
            >
                <div
                    class="badge badge-soft badge-info absolute top-0 left-0 group-hover:block hidden"
                >
                    web-tabs
                </div>
                <div class="w-full">
                    <web-tabs
                        tabs='[{"label": "Tab 1", "id": "t1"}, {"label": "Tab 2", "id": "t2"}, {"label": "Tab 3", "id": "t3"}]'
                        active="t1"
                    >
                        <div slot="t1" class="p-4">Content for Tab 1</div>
                        <div slot="t2" class="p-4">Content for Tab 2</div>
                        <div slot="t3" class="p-4">Content for Tab 3</div>
                    </web-tabs>
                </div>
            </figure>

            <!-- Web Table -->
            <figure
                class="relative group hover:bg-gray-500/5 px-4 py-6 rounded-lg place-content-center border border-white/10 md:col-span-2 xl:col-span-3"
            >
                <div
                    class="badge badge-soft badge-info absolute top-0 left-0 group-hover:block hidden"
                >
                    web-table
                </div>
                <div class="h-[300px] w-full">
                    <web-table
                        mainColors="#2ebd85|#f5465c|#a855f7|#00c7d4|#fbbf24"
                        columns='[{"label": "Time", "field": "time", "width": "100px"},{"label": "Price", "field": "price", "align": "right", "width": "1fr", "color": "#2ebd85", "bold": true},{"label": "Volume", "field": "volume", "align": "right", "width": "1fr"}]'
                        data='[{"time": "14:20:00", "price": "1200", "volume": "5000"},{"time": "14:20:01", "price": "1201", "volume": "1000"},{"time": "14:20:05", "price": "1205", "volume": "2500"}]'
                    ></web-table>
                </div>
            </figure>

            <!-- Web Breadcrumb -->
            <figure
                class="relative group hover:bg-gray-500/5 px-4 py-6 rounded-lg place-content-center border border-white/10 md:col-span-2 xl:col-span-3"
            >
                <div
                    class="badge badge-soft badge-info absolute top-0 left-0 group-hover:block hidden"
                >
                    web-breadcrumb
                </div>
                <div class="w-full flex place-content-center">
                    <web-breadcrumb
                        items='[{"label": "Home", "href": "/"}, {"label": "Components", "href": "/components"}, {"label": "Breadcrumb"}]'
                    ></web-breadcrumb>
                </div>
            </figure>

            <!-- Web Currency -->
            <figure
                class="relative group hover:bg-gray-500/5 px-4 py-6 rounded-lg place-content-center border border-white/10"
            >
                <div
                    class="badge badge-soft badge-info absolute top-0 left-0 group-hover:block hidden"
                >
                    web-currency
                </div>
                <div class="flex flex-col gap-4 w-full">
                    <web-currency value="1000" prefix="$"></web-currency>
                    <web-currency
                        value="2500"
                        suffix="EUR"
                        format="true"
                        precision="2"></web-currency>
                </div>
            </figure>

            <!-- Web Datetime -->
            <figure
                class="relative group hover:bg-gray-500/5 px-4 py-6 rounded-lg place-content-center border border-white/10"
            >
                <div
                    class="badge badge-soft badge-info absolute top-0 left-0 group-hover:block hidden"
                >
                    web-datetime
                </div>
                <div class="flex flex-col gap-4 w-full">
                    <web-datetime placeholder="Select Date" type="default"
                    ></web-datetime>
                    <web-datetime type="datetime" placeholder="Select Date & Time"></web-datetime>
                </div>
            </figure>

            <!-- Web Dropdown -->
            <figure
                class="relative group hover:bg-gray-500/5 px-4 py-6 rounded-lg flex items-center justify-center border border-white/10 z-10"
            >
                <div
                    class="badge badge-soft badge-info absolute top-0 left-0 group-hover:block hidden"
                >
                    web-dropdown
                </div>
                <div class="w-full flex place-content-center py-8">
                    <web-dropdown
                        label="Menu"
                        icon="lucide:menu"
                        items='[{"label": "Profile", "icon":"lucide:user"}, {"label": "Settings", "icon":"lucide:settings"}]'
                    ></web-dropdown>
                </div>
            </figure>

            <!-- Web Fab -->
            <figure
                class="relative group hover:bg-gray-500/5 px-4 py-6 rounded-lg place-content-center border border-white/10 overflow-hidden h-40"
            >
                <div
                    class="badge badge-soft badge-info absolute top-0 left-0 group-hover:block hidden z-10"
                >
                    web-fab
                </div>
                <div class="w-full h-full relative">
                    <web-fab position="absolute"></web-fab>
                </div>
            </figure>

            <!-- Web Files -->
            <figure
                class="relative group hover:bg-gray-500/5 px-4 py-6 rounded-lg place-content-center border border-white/10"
            >
                <div
                    class="badge badge-soft badge-info absolute top-0 left-0 group-hover:block hidden"
                >
                    web-files
                </div>
                <div class="w-full max-w-sm mx-auto">
                    <web-files multiple="true"></web-files>
                </div>
            </figure>

            <!-- Web Pagination -->
            <figure
                class="relative group hover:bg-gray-500/5 px-4 py-6 rounded-lg place-content-center border border-white/10 md:col-span-2 xl:col-span-3"
            >
                <div
                    class="badge badge-soft badge-info absolute top-0 left-0 group-hover:block hidden"
                >
                    web-pagination
                </div>
                <div class="w-full flex place-content-center">
                    <web-pagination total="100" current="1" pageSize="10"
                    ></web-pagination>
                </div>
            </figure>

            <!-- Web Photor -->
            <figure
                class="relative group hover:bg-gray-500/5 px-4 py-6 rounded-lg place-content-center border border-white/10 md:col-span-2"
            >
                <div
                    class="badge badge-soft badge-info absolute top-0 left-0 group-hover:block hidden"
                >
                    web-photor
                </div>
                <div class="flex flex-col gap-6 w-full">
                    <div>
                        <p class="text-[10px] uppercase opacity-50 mb-3">Single (with crop)</p>
                        <web-photor id="uploader-single"></web-photor>
                    </div>
                    <div class="border-t border-white/10 pt-6">
                        <p class="text-[10px] uppercase opacity-50 mb-3">Multiple (with crop)</p>
                        <web-photor id="uploader-multi" multiple></web-photor>
                    </div>
                </div>
            </figure>

            <!-- Web Upload Photor -->
            <figure
                class="relative group hover:bg-gray-500/5 px-4 py-6 rounded-lg place-content-center border border-white/10 md:col-span-2"
            >
                <div
                    class="badge badge-soft badge-info absolute top-0 left-0 group-hover:block hidden"
                >
                    svc-photor
                </div>
                <div class="flex flex-col gap-4 w-full max-w-md mx-auto">
                    <div>
                        <p class="text-[10px] uppercase opacity-50 mb-2">Single URL</p>
                        <svc-photor placeholder="Upload ảnh → lấy URL"></svc-photor>
                    </div>
                    <div>
                        <p class="text-[10px] uppercase opacity-50 mb-2">Multiple URLs</p>
                        <svc-photor multiple placeholder="Upload nhiều ảnh → link1|link2..."></svc-photor>
                    </div>
                </div>
            </figure>

            <!-- Web Popover -->
            <figure
                class="relative group hover:bg-gray-500/5 px-4 py-6 rounded-lg place-content-center border border-white/10 z-10"
            >
                <div
                    class="badge badge-soft badge-info absolute top-0 left-0 group-hover:block hidden"
                >
                    web-popover
                </div>
                <div class="flex place-content-center py-12">
                    <web-popover>
                        <web-button slot="trigger">Open Popover</web-button>
                        <div
                            class="p-4 text-sm whitespace-nowrap bg-base-100 rounded border border-gray-700"
                        >
                            This is the popover content
                        </div>
                    </web-popover>
                </div>
            </figure>

            <!-- Web Split -->
            <figure
                class="relative group hover:bg-gray-500/5 px-4 py-6 rounded-lg place-content-center border border-white/10 md:col-span-2 xl:col-span-3 z-0"
            >
                <div
                    class="badge badge-soft badge-info absolute top-0 left-0 group-hover:block hidden"
                >
                    web-split
                </div>
                <div
                    class="h-[200px] w-full border border-gray-700/50 rounded-lg overflow-hidden relative"
                >
                    <web-split
                        direction="horizontal"
                        size="0.5"
                        showExpanded="true"
                    >
                        <div
                            slot="primary"
                            class="w-full h-full bg-base-100 p-4 flex items-center justify-center"
                        >
                            Left Pane
                        </div>
                        <div
                            slot="secondary"
                            class="w-full h-full bg-base-200 p-4 flex items-center justify-center"
                        >
                            Right Pane
                        </div>
                    </web-split>
                </div>
            </figure>

            <!-- Web Text & Textarea -->
            <figure
                class="relative group hover:bg-gray-500/5 px-4 py-6 rounded-lg place-content-center border border-white/10 md:col-span-2"
            >
                <div
                    class="badge badge-soft badge-info absolute top-0 left-0 group-hover:block hidden"
                >
                    web-text & textarea
                </div>
                <div class="flex flex-col gap-4 w-full max-w-md mx-auto">
                    <web-text
                        placeholder="Enter username"
                        prefix="@"
                        clearable="true"></web-text>
                    <web-text type="password" placeholder="Enter password"
                    ></web-text>
                    <web-textarea placeholder="Enter message" rows="3"
                    ></web-textarea>
                    
