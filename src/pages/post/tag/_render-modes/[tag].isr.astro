---
export const prerender = false;

import Core from '@/layouts/Core.astro';
import { KINDS } from '@/components/Catalog/kinds';
import Feed from '@/components/Catalog/Feed.astro';
import { fetchCollection } from '@/services/core/fetcher.server.js';
import { pickLang } from '@/services/tools/lingo.js';
import { tagSlugMap } from '@/services/tools/util';
import { site } from '@/services/tools/site';
import { menuItems, policies, socials } from '@/modules/gift/shop.js'; // footer chung giftoraddk.com
import { menu as postMenu, tints, postSeo } from '@/modules/post/index.js';
import I18nText from '@/components/I18nText.astro';

// Biến thể ISR của src/pages/post/tag/[tag].astro — xem
// src/pages/product/tag/_render-modes/[tag].isr.astro để biết cơ chế swap
// (renderModeIntegration, astro.config.mjs).

const tagSlug = Astro.params.tag as string;
const allPosts = await fetchCollection('posts');
const entry = tagSlugMap(allPosts).get(tagSlug);

if (!entry) Astro.response.status = 404;

const tag = entry?.label ?? '';
const posts = entry?.items ?? [];

const seo = entry ? postSeo.tag(tag, posts.length) : null;
const pageTitle = seo ? pickLang(seo.heading) : pickLang({ en: 'Not found', vi: 'Không tìm thấy' });
const pageDescription = seo ? pickLang(seo.description) : '';
const breadcrumb = [
	{ label: pickLang({ en: 'Home', vi: 'Trang chủ' }), href: '/' },
	{ label: pickLang({ en: 'Posts', vi: 'Bài viết' }), href: '/post/' },
	{ label: pickLang({ en: 'Topics', vi: 'Chủ đề' }), href: '/post/tag/' },
	{ label: tag },
];
const image = posts.map((p: any) => String(p.pics || '').split('|').find(Boolean)).find(Boolean);
const bg = null;
---

<Core menu={postMenu} tints={tints} title={seo ? pickLang(seo.title) : pageTitle} description={pageDescription} image={image} noindex={!entry} footer={{ columns: menuItems, policies, socials, bg }}>
	{entry ? (
		<Feed kind={KINDS.post} items={posts} allItems={allPosts} title={pageTitle} description={pageDescription}
			path={`/post/tag/${tagSlug}/`} activeTag={tagSlug} breadcrumb={breadcrumb} />
	) : (
		<div class="mx-auto max-w-6xl px-4 py-24 text-center opacity-60">
			<I18nText text={{ en: 'Category not found.', vi: 'Không tìm thấy danh mục này.' }} />
		</div>
	)}
</Core>
