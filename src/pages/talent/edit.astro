---
import Core from '@/layouts/Core.astro';
import { variant } from '@/modules/talent-page.js';
---

<Core title="Chỉnh sửa hồ sơ Talent" theme={variant.theme} variant={variant}>
	<script>
		import '@/webs/talent/svc-talent-edit.js';
		import { auth } from '@/webs/auth/tools/service.js';

		async function applyCurrentUser() {
			const el = document.getElementById('talent-edit') as any;
			if (!el) return;
			const user = await auth.get();
			el.userId = user?.id ?? '';
		}
		document.addEventListener('astro:page-load', applyCurrentUser);
	</script>
	<div class='p-4 lg:p-6 max-w-2xl mx-auto'>
		<svc-talent-edit id="talent-edit" ui={variant.ui} theme={variant.theme}
			mainColors={variant.mainColors} textColor={variant.textColor}></svc-talent-edit>
	</div>
</Core>
