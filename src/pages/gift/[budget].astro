---
// /gift/<mức ngân sách> — 1 trang static / mức (modules/gift/budget.js): HTML chỉ chứa sản phẩm có giá trong khoảng của
// mức (min <= giá < max), nhóm "Mức giá" của bộ lọc là link sang các mức khác, các nhóm còn lại lọc ngay trên trang.
// Giao diện: components/Shop/Shop.astro; dữ liệu + SEO/GEO: modules/gift/catalog.js shopPageData.
import CoreShop from '@/layouts/CoreShop.astro';
import Shop from '@/components/Shop/Shop.astro';
import GiftAide from '@/components/Gift/Aide.astro';
import { tintsChrome, shop } from '@/modules/gift/shop.js';
import { budgetTiers } from '@/modules/gift/budget.js';
import { shopPageData } from '@/modules/gift/catalog.js';

// getStaticPaths() được compiler tách ra scope riêng, chỉ giữ lại import — dùng thẳng budgetTiers đã import.
export function getStaticPaths() {
	return budgetTiers.map((tier) => ({ params: { budget: tier.key } }));
}

// Không tìm thấy mức: lúc build nghĩa là dữ liệu/route lệch nhau — báo lỗi build thay vì ra trang rỗng/crash khó lần;
// on-demand (PUBLIC_RENDER=isr, getStaticPaths bị bỏ qua) thì đó là URL lạ → 404.
const key = Astro.params.budget;
if (!budgetTiers.some((t) => t.key === key)) {
	if (!Astro.isPrerendered) return new Response(null, { status: 404 });
	throw new Error(`[gift/[budget]] mức ngân sách không tồn tại: ${key}`);
}

const data = await shopPageData({ type: 'tier', key });
const { page } = data;
---

<CoreShop {...tintsChrome} shop={shop} title={page.title} description={page.description} lang={page.lang} jsonLd={data.jsonLd} image={page.image}>
	<Shop data={data} />
	<GiftAide theme={tintsChrome.theme} lang={page.lang} />
</CoreShop>
