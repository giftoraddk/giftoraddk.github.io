---
import Core from '@/layouts/Core.astro';
import { KINDS } from '@/components/Catalog/kinds';
import PostDetailBody from '@/components/Catalog/Detail.astro';
import { fetchCollection } from '@/services/core/fetcher.server.js';
import { pickLang } from '@/services/tools/lingo.js';
import { postSlug } from '@/services/tools/util';
import { menuItems, policies, socials } from '@/modules/gift/shop.js'; // footer chung giftoraddk.com
import { menu as postMenu, tints } from '@/modules/post/index.js';

// Trang chi tiết bài viết — biến thể SSG (mặc định). Nội dung thật nằm trong components/Catalog/Detail.astro
// (dùng chung với biến thể ISR ở src/pages/post/_render-modes/[slug].isr.astro, xem
// astro.config.mjs renderModeIntegration — PUBLIC_RENDER=isr swap file này lúc build).
//
// URL dùng slug từ khoá (vd /post/ten-bai-viet-{id}/) thay vì id thô — cùng cách
// src/pages/product/[slug].astro làm, xem postSlug() (services/helper.js).

export async function getStaticPaths() {
	const posts = await fetchCollection('posts');
	return posts.map(post => ({
		params: { slug: postSlug(post) },
		props:  { post, allPosts: posts },
	}));
}

const { post, allPosts } = Astro.props as { post: any; allPosts: any[] };

const pics = (post.pics || '').split('|').filter(Boolean);
const heroImg = pics[0] || '';
const description = post.description || String(post.content || '').replace(/<[^>]*>/g, '').replace(/\s+/g, ' ').trim().slice(0, 160) || '';
const tags = String(post.tags || '').split('|').map((t: string) => t.trim()).filter(Boolean);
const pageTitle = post.title || pickLang({ en: 'Post', vi: 'Bài viết' });
const bg = null;
---

<Core menu={postMenu} tints={tints} title={pageTitle} description={description} image={heroImg} articleDate={post.created_at} articleModified={post.updated_at} articleTags={tags} footer={{ columns: menuItems, policies, socials, bg }}>
	<PostDetailBody kind={KINDS.post} item={post} allItems={allPosts} />
</Core>
