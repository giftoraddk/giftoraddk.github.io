---
import '../styles/themes/gold.css';
import Head from "@/components/Head/Base.astro";
// jsonLd / ogImage: chuyển thẳng cho Head (vd /system/<ngành> — trang app nhưng vẫn được index).
const { title = 'Apex app', description = '', noindex = false, viewport, jsonLd = [], ogImage } = Astro.props;
---

<!doctype html>
<html lang='en'>
	<head>
		<Head
			title={title}
			description={description}
			noindex={noindex}
			viewport={viewport}
			jsonLd={jsonLd}
			ogImage={ogImage}
		/>
	</head>
	<body>
		<main id='main'>
			<slot />
		</main>
	</body>
</html>