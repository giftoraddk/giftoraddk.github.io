---
import "../styles/themes/default.css";
import { ClientRouter, fade } from "astro:transitions";
import Head from "@/components/Head/Base.astro";

interface Props {
  title?: string;
  description?: string;
  frontmatter?: { title?: string; description?: string };
}

// ─── Types ────────────────────────────────────────────────────────────────────

type BiLabel = string | { vi: string; en: string };

interface NavItem {
  label: BiLabel;
  slug?: string;    // docs-relative → /docs/{lang}/{slug}
  href?: string;    // absolute, used as-is
  external?: true;  // opens _blank
}

interface NavGroup {
  label: BiLabel;
  icon?: string;           // svg path data for the group icon
  variant?: 'playground';  // visual variant
  defaultOpen?: true;      // force open regardless of active state
  items: NavItem[];
}

// ─── Config ───────────────────────────────────────────────────────────────────

const NAV_CONFIG: NavGroup[] = [
  {
    label: { vi: 'Giới thiệu', en: 'Introduction' },
    items: [
      { label: { vi: 'Tổng quan', en: 'Overview' },       slug: 'introduction' },
      { label: { vi: 'Bắt đầu nhanh', en: 'Quick Start' }, slug: 'quickstart'   },
    ],
  },
  {
    label: { vi: 'Bắt đầu', en: 'Getting Started' },
    items: [
      { label: { vi: 'Kiến trúc hệ thống', en: 'Architecture' }, slug: 'architecture' },
      { label: { vi: 'Luồng dữ liệu', en: 'Data Flow' },         slug: 'dataflow'     },
    ],
  },
  {
    label: { vi: 'Tính năng', en: 'Features' },
    items: [
      { label: 'Web Boxs',   slug: 'web-boxs'  },
      { label: 'Web Board',  slug: 'web-board' },
      { label: 'Conductor',  slug: 'conductor' },
    ],
  },
  {
    label: { vi: 'Giao diện & Hoạt ảnh', en: 'Styles & Animations' },
    items: [
      { label: 'Theming',                                          slug: 'theming'    },
      { label: { vi: 'Hoạt ảnh', en: 'Animations' },              slug: 'animations' },
    ],
  },
  {
    label: { vi: 'Khái niệm chung', en: 'Common Concepts' },
    items: [
      { label: 'Design Guide',                                                 slug: 'design-guide'   },
      { label: { vi: 'Cấu hình Section', en: 'Section Config' },              slug: 'section-config' },
    ],
  },
  {
    label: 'Components',
    items: [
      { label: { vi: 'Tổng quan', en: 'Overview' }, slug: 'components'              },
      { label: 'web-alert',                          slug: 'components/web-alert'    },
      { label: 'web-avatar',                         slug: 'components/web-avatar'   },
      { label: 'web-bg',                             slug: 'components/web-bg'       },
      { label: 'web-breadcrumb',                     slug: 'components/web-breadcrumb' },
      { label: 'web-button',                         slug: 'components/web-button'   },
      { label: 'web-checkbox',                       slug: 'components/web-checkbox' },
      { label: 'web-dialog',                         slug: 'components/web-dialog'   },
      { label: 'web-dropdown',                       slug: 'components/web-dropdown' },
      { label: 'web-expansion',                      slug: 'components/web-expansion'},
      { label: 'web-fab',                            slug: 'components/web-fab'      },
      { label: 'web-gallery',                        slug: 'components/web-gallery'  },
      { label: 'web-loader',                         slug: 'components/web-loader'   },
      { label: 'web-pagination',                     slug: 'components/web-pagination'},
      { label: 'web-popover',                        slug: 'components/web-popover'  },
      { label: 'web-pre',                            slug: 'components/web-pre'      },
      { label: 'web-progress',                       slug: 'components/web-progress' },
      { label: 'web-radio',                          slug: 'components/web-radio'    },
      { label: 'web-rating',                         slug: 'components/web-rating'   },
      { label: 'web-select',                         slug: 'components/web-select'   },
      { label: 'web-slider',                         slug: 'components/web-slider'   },
      { label: 'web-steps',                          slug: 'components/web-steps'    },
      { label: 'web-table',                          slug: 'components/web-table'    },
      { label: 'web-tabs',                           slug: 'components/web-tabs'     },
      { label: 'web-text',                           slug: 'components/web-text'     },
      { label: 'web-toast',                          slug: 'components/web-toast'    },
      { label: 'web-toggle',                         slug: 'components/web-toggle'   },
      { label: 'web-tooltip',                        slug: 'components/web-tooltip'  },
    ],
  },
  {
    label: 'Playground',
    variant: 'playground',
    defaultOpen: true,
    // play icon path
    icon: 'M5 3l14 9-14 9V3z',
    items: [
      { label: 'Component UI', href: '/ui', external: true },
      { label: 'Sandbox', href: '/ui/sandbox', external: true },
      { label: 'Shop Cafe',  href: '/shop',  external: true },
      { label: 'Basic Landing Page',  href: '/landing',  external: true },
      { label: 'Stable Landing Page',  href: '/landing/stable',  external: true },
      { label: 'Spatial Landing Page', href: '/landing/spatial', external: true },
    ],
  },
];

// ─── Runtime ──────────────────────────────────────────────────────────────────

const { frontmatter } = Astro.props;
const title       = Astro.props.title       ?? frontmatter?.title       ?? 'Docs';
const description = Astro.props.description ?? frontmatter?.description ?? '';
const pathname    = Astro.url.pathname;

const langMatch    = pathname.match(/^\/docs\/(vi|en)(\/|$)/);
const lang         = (langMatch?.[1] ?? 'vi') as 'vi' | 'en';
const alternateLang = lang === 'vi' ? 'en' : 'vi';
const alternatePath = pathname.replace(/^\/docs\/(vi|en)/, `/docs/${alternateLang}`);

// Resolve bilingual label
const L = (label: BiLabel) => typeof label === 'string' ? label : label[lang];

// Resolve href: slug → /docs/{lang}/{slug}, or absolute href as-is
const H = (item: NavItem) =>
  item.href ? item.href : `/docs/${lang}/${item.slug}`;

function isActive(item: NavItem) {
  const href   = H(item);
  const clean  = (s: string) => s.replace(/\/$/, '');
  return clean(pathname) === clean(href);
}

function isGroupActive(group: NavGroup) {
  return !group.defaultOpen && group.items.some(isActive);
}

const backLink  = lang === 'vi' ? '← Trang chủ' : '← Home';
const langLabel = lang === 'vi' ? 'EN' : 'VI';
---

<html lang={lang} class="scroll-smooth" data-theme="light">
  <head>
    <ClientRouter />
    <Head title={`${title} — Docs`} description={description} />
    <script is:inline>
      (function() {
        const m = document.cookie.match(/(?:^|; )dark=([^;]*)/);
        const t = m ? decodeURIComponent(m[1]) : null;
        if (t) document.documentElement.setAttribute('data-theme', t);
      })();
      document.addEventListener('astro:before-swap', function(e) {
        const theme = document.documentElement.getAttribute('data-theme');
        if (theme) e.newDocument.documentElement.setAttribute('data-theme', theme);
      });
    </script>
  </head>
  <body transition:animate={fade({ duration: "0.3s" })}>
    <div class="doc-layout">

      <aside class="doc-sidebar">
        <div class="sidebar-header">
          <div class="sidebar-top">
            <a href="/" class="back-link">{backLink}</a>
            <a href={alternatePath} class="lang-switch">{langLabel}</a>
          </div>
          <span class="doc-label">Documentation</span>
        </div>

        <nav class="sidebar-nav">
          {NAV_CONFIG.map(group => (
            <details
              class={`nav-group${group.variant ? ` nav-group--${group.variant}` : ''}`}
              open={group.defaultOpen || isGroupActive(group) || undefined}
            >
              <summary class="nav-group-summary">
                <span class={`nav-group-label${group.variant ? ` nav-group-label--${group.variant}` : ''}`}>
                  {group.icon && (
                    <svg class="group-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d={group.icon} />
                    </svg>
                  )}
                  {L(group.label)}
                </span>
                <svg class="nav-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none">
                  <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </summary>

              <div class="nav-items">
                {group.items.map(item => (
                  <a
                    href={H(item)}
                    class={`nav-link${item.external ? ' nav-link--external' : ''}${isActive(item) ? ' active' : ''}`}
                    target={item.external ? '_blank' : undefined}
                    rel={item.external ? 'noopener noreferrer' : undefined}
                  >
                    {L(item.label)}
                    {item.external && (
                      <svg class="ext-icon" width="10" height="10" viewBox="0 0 12 12" fill="none">
                        <path d="M3.5 8.5L8.5 3.5M8.5 3.5H5M8.5 3.5V7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    )}
                  </a>
                ))}
              </div>
            </details>
          ))}
        </nav>
      </aside>

      <main class="doc-main">
        <article class="doc-prose">
          <slot />
        </article>
      </main>

    </div>
  </body>
</html>

<style is:global>
  body { margin: 0; background: var(--color-base-100); color: var(--color-base-content); }

  .doc-layout { display: flex; min-height: 100vh; }

  .doc-sidebar {
    width: 260px;
    flex-shrink: 0;
    border-right: 1px solid var(--color-base-300);
    position: sticky;
    top: 0;
    height: 100vh;
    overflow-y: auto;
    background: var(--color-base-100);
  }

  .sidebar-header {
    padding: 1.25rem 1rem 0.875rem;
    border-bottom: 1px solid var(--color-base-300);
  }

  .sidebar-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.375rem;
  }

  .back-link { font-size: 0.875rem; color: var(--color-primary); text-decoration: none; font-weight: 500; }
  .back-link:hover { opacity: 0.75; }

  .lang-switch {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 0.3rem;
    border: 1px solid var(--color-base-300);
    color: color-mix(in oklab, var(--color-base-content) 65%, transparent);
    text-decoration: none;
    letter-spacing: 0.06em;
    transition: all 0.15s;
  }
  .lang-switch:hover {
    background: var(--color-base-200);
    color: var(--color-base-content);
    border-color: var(--color-primary);
  }

  .doc-label {
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 700;
    color: color-mix(in oklab, var(--color-base-content) 30%, transparent);
  }

  .sidebar-nav { padding: 0.75rem 0.625rem 2rem; }

  /* ── Groups ── */
  .nav-group { margin-bottom: 0.125rem; }
  .nav-group summary { list-style: none; }
  .nav-group summary::-webkit-details-marker { display: none; }

  .nav-group-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.45rem 0.625rem;
    border-radius: 0.45rem;
    cursor: pointer;
    user-select: none;
    transition: background 0.15s;
  }
  .nav-group-summary:hover { background: var(--color-base-200); }

  .nav-group-label {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-base-content);
  }

  .group-icon {
    flex-shrink: 0;
    opacity: 0.7;
  }

  /* Playground variant */
  .nav-group-label--playground {
    color: var(--color-primary);
  }
  .nav-group-label--playground .group-icon {
    fill: var(--color-primary);
    stroke: none;
    opacity: 1;
  }

  .nav-chevron {
    flex-shrink: 0;
    color: color-mix(in oklab, var(--color-base-content) 40%, transparent);
    transition: transform 0.2s ease;
    transform: rotate(-90deg);
  }
  details[open] > .nav-group-summary .nav-chevron { transform: rotate(0deg); }

  /* ── Items ── */
  .nav-items { padding: 0.2rem 0 0.5rem; }

  .nav-link {
    display: block;
    padding: 0.35rem 0.75rem 0.35rem 1.5rem;
    border-radius: 0.4rem;
    font-size: 0.84rem;
    color: color-mix(in oklab, var(--color-base-content) 68%, transparent);
    text-decoration: none;
    transition: background 0.12s, color 0.12s;
    line-height: 1.4;
  }
  .nav-link:hover { color: var(--color-base-content); background: var(--color-base-200); }
  .nav-link.active {
    color: var(--color-primary);
    background: color-mix(in oklab, var(--color-primary) 10%, transparent);
    font-weight: 600;
  }

  /* External link */
  .nav-link--external {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .nav-link--external:hover { color: var(--color-primary); }

  .ext-icon { flex-shrink: 0; opacity: 0.45; }
  .nav-link--external:hover .ext-icon { opacity: 1; }

  /* ── Main ── */
  .doc-main { flex: 1; min-width: 0; overflow: hidden; }

  .doc-prose {
    max-width: 820px;
    margin: 0 auto;
    padding: 2.5rem 2rem 5rem;
  }

  .doc-prose h1 {
    font-size: 2.1rem; font-weight: 800; line-height: 1.2;
    margin: 0 0 0.5rem; color: var(--color-base-content);
  }
  .doc-prose h2 {
    font-size: 1.45rem; font-weight: 700; line-height: 1.3;
    margin: 2.5rem 0 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-base-300);
    color: var(--color-base-content);
  }
  .doc-prose h3 {
    font-size: 1.1rem; font-weight: 600;
    margin: 1.75rem 0 0.5rem; color: var(--color-base-content);
  }
  .doc-prose h4 {
    font-size: 0.95rem; font-weight: 600;
    margin: 1.25rem 0 0.4rem; color: var(--color-base-content);
  }
  .doc-prose p {
    margin: 0 0 1rem; line-height: 1.75;
    color: color-mix(in oklab, var(--color-base-content) 85%, transparent);
  }
  .doc-prose ul, .doc-prose ol {
    margin: 0 0 1rem; padding-left: 1.5rem;
    color: color-mix(in oklab, var(--color-base-content) 85%, transparent);
  }
  .doc-prose ul { list-style: disc; }
  .doc-prose ol { list-style: decimal; }
  .doc-prose li { margin-bottom: 0.3rem; line-height: 1.75; }
  .doc-prose strong { font-weight: 600; color: var(--color-base-content); }
  .doc-prose em { font-style: italic; }

  .doc-prose :not(pre) > code {
    font-family: 'Fira Code', 'Cascadia Code', Consolas, Monaco, monospace;
    font-size: 0.875em;
    background: var(--color-base-200);
    color: var(--color-primary);
    padding: 0.15em 0.4em;
    border-radius: 0.3em;
    border: 1px solid var(--color-base-300);
  }

  .doc-prose pre {
    margin: 0 0 1.5rem;
    border-radius: 0.75rem;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.07);
  }
  .doc-prose pre code {
    background: none !important; border: none !important;
    padding: 0 !important; color: inherit !important;
    font-size: 0.85rem;
  }
  .astro-code { padding: 1.25rem !important; font-size: 0.85rem !important; line-height: 1.6 !important; }

  .doc-prose table { width: 100%; border-collapse: collapse; margin: 0 0 1.5rem; font-size: 0.875rem; }
  .doc-prose th {
    background: var(--color-base-200); padding: 0.6rem 1rem;
    text-align: left; font-weight: 600; border: 1px solid var(--color-base-300);
    font-size: 0.8rem; color: var(--color-base-content);
  }
  .doc-prose td {
    padding: 0.55rem 1rem; border: 1px solid var(--color-base-300);
    color: color-mix(in oklab, var(--color-base-content) 82%, transparent);
    vertical-align: top;
  }
  .doc-prose tr:nth-child(even) td { background: color-mix(in oklab, var(--color-base-200) 45%, transparent); }

  .doc-prose blockquote {
    border-left: 3px solid var(--color-primary);
    padding: 0.75rem 1rem;
    margin: 0 0 1.5rem;
    background: color-mix(in oklab, var(--color-primary) 8%, transparent);
    border-radius: 0 0.5rem 0.5rem 0;
  }
  .doc-prose blockquote p { margin: 0; color: color-mix(in oklab, var(--color-base-content) 90%, transparent); }

  .doc-prose hr { border: none; border-top: 1px solid var(--color-base-300); margin: 2.5rem 0; }
  .doc-prose a { color: var(--color-primary); text-decoration: underline; text-underline-offset: 2px; }
  .doc-prose a:hover { opacity: 0.8; }

  .doc-intro {
    padding: 0.25rem 0 1.75rem;
    border-bottom: 1px solid var(--color-base-300);
    margin-bottom: 2rem;
  }
  .doc-intro p { font-size: 1.05rem; color: color-mix(in oklab, var(--color-base-content) 70%, transparent); }

  .prop-badge {
    display: inline-block;
    font-size: 0.7rem;
    padding: 0.1em 0.4em;
    border-radius: 0.25em;
    font-weight: 600;
    background: color-mix(in oklab, var(--color-info) 15%, transparent);
    color: var(--color-info);
    border: 1px solid color-mix(in oklab, var(--color-info) 25%, transparent);
    margin-left: 0.3em;
    vertical-align: middle;
  }
</style>
